# 开发服务器端口
VITE_PORT=9100
# 开发态代理目标：后端宿主的 Http 端点（backend-next/src/XiHan.BasicApp.Host/appsettings.json 的 Kestrel:Endpoints:Http）
VITE_DEV_PROXY_TARGET=http://localhost:9710
# 构建期的 API 源；留空 = 同源
VITE_API_BASE_URL=
# 登录页品牌区（留空取应用名文案与 /favicon.png）
VITE_APP_TITLE=
VITE_APP_SUBTITLE=
VITE_APP_DESCRIPTION=
VITE_APP_LOGO=
# 首页兜底路径（固定首页标签、守卫重定向）；留空 = /
VITE_HOME_PATH=
# 实时 Hub 路径（方案 6.9）；留空 = 不建实时连接（6.0 的实时链路接上前保持留空）
VITE_REALTIME_HUB=
