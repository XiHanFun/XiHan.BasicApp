        "operationId": "users.delete",
        "tags": [
          "users"
        ],
        "summary": "Delete users in batch (soft delete) and revoke their sessions; you cannot delete yourself. Requires identity.users.delete.",
        "x-xihan-stability": "Preview",
        "x-xihan-permission": "identity.users.delete",
