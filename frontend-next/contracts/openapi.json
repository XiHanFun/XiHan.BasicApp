              "application/json": {
                "schema": {
                  "title": "LogoutResponse",
                  "type": "object",
                  "properties": {
                    "sessionId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "revokedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "sessionId",
                    "revokedAt"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
