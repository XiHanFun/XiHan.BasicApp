        ],
        "summary": "List users with paging, filters, keyword and sorting; tenant principals only see their own tenant. Requires identity.users.read.",
        "x-xihan-stability": "Preview",
        "x-xihan-permission": "identity.users.read",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "PageRequest",
                "type": "object",
                "properties": {
