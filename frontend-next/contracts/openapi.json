{
  "openapi": "3.1.0",
  "info": {
    "title": "XiHan.BasicApp",
    "version": "6.0.0-preview.1"
  },
  "paths": {
    "/api/users": {
      "post": {
        "operationId": "users.create",
        "tags": [
          "users"
        ],
        "summary": "Create a user in the current tenant; requires the identity.users.create permission.",
        "x-xihan-stability": "Preview",
        "x-xihan-permission": "identity.users.create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "CreateUserRequest",
                "type": "object",
                "properties": {
                  "userName": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9._-]*$"
                  },
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "email": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 256
                  }
                },
                "required": [
                  "userName",
                  "displayName"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "title": "UserResponse",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "userName": {
                      "type": "string"
                    },
                    "displayName": {
                      "type": "string"
                    },
                    "email": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "homeTenantId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "Active",
                        "Disabled",
                        "Locked"
                      ]
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "createdBy": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "userName",
                    "displayName",
                    "homeTenantId",
                    "status",
                    "createdAt"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "operationId": "users.get",
        "tags": [
          "users"
        ],
        "summary": "Get a user of the current tenant by ID; requires the identity.users.read permission.",
        "x-xihan-stability": "Preview",
        "x-xihan-permission": "identity.users.read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "title": "UserResponse",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "userName": {
                      "type": "string"
                    },
                    "displayName": {
                      "type": "string"
                    },
                    "email": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "homeTenantId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "Active",
                        "Disabled",
                        "Locked"
                      ]
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "createdBy": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "userName",
                    "displayName",
                    "homeTenantId",
                    "status",
                    "createdAt"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/users:list": {
      "post": {
        "operationId": "users.list",
        "tags": [
          "users"
        ],
        "summary": "List users of the current tenant with paging, filters, keyword and sorting; requires the identity.users.read permission.",
        "x-xihan-stability": "Preview",
        "x-xihan-permission": "identity.users.read",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "PageRequest",
                "type": "object",
                "properties": {
                  "page": {
                    "$ref": "#/components/schemas/PageInfo"
                  },
                  "filters": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/PageFilter"
                    },
                    "maxItems": 32
                  },
                  "keyword": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 256
                  },
                  "sorts": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/PageSort"
                    },
                    "maxItems": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "title": "PageResult",
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/UserResponse"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "page": {
                      "$ref": "#/components/schemas/PageInfo"
                    }
                  },
                  "required": [
                    "items",
                    "total",
                    "page"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "PageFilter": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "operator": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(eq|ne|contains|gt|ge|lt|le|in)$"
          },
          "value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          }
        },
        "required": [
          "field",
          "operator"
        ]
      },
      "PageInfo": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 500
          },
          "skip": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PageSort": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "descending": {
            "type": "boolean"
          }
        },
        "required": [
          "field"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "homeTenantId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Disabled",
              "Locked"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "userName",
          "displayName",
          "homeTenantId",
          "status",
          "createdAt"
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "x-xihan-permissions": {
      "identity.users.create": {
        "code": "identity.users.create",
        "displayName": "Create users",
        "description": "Create users in the current tenant."
      },
      "identity.users.read": {
        "code": "identity.users.read",
        "displayName": "Read users",
        "description": "View users of the current tenant."
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}