# docker compose 变量。复制为 .env 后按需修改：cp .env.example .env
# 该文件只放容器编排参数；应用密钥（JWT、第三方凭据等）在
# backend/src/main/XiHan.BasicApp.WebHost/appsettings.Production.json，由 compose 挂载。

# 随栈启动的 PostgreSQL。改这里等于同时改建库参数与后端连接串。
POSTGRES_DB=XiHanBasicApp
POSTGRES_USER=xihan
POSTGRES_PASSWORD=change-me

# 宿主机端口
FRONTEND_PORT=8080
BACKEND_PORT=9708

# 前端构建期的 API 源。留空 = 同源，走 nginx 反代（推荐）。
# 前后端分域部署时填后端绝对地址，如 https://basicappapi.example.com
VITE_API_BASE_URL=
