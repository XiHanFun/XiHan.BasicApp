# docker compose 变量。复制为 .env 后修改：cp .env.example .env
# 只放容器编排参数与首次启动必需的密钥；其余配置项见 backend/src/XiHan.BasicApp.Host/appsettings.json，
# 要改时在 docker-compose.yml 的 x-backend-env 里按键名加环境变量（双下划线分节）

# 随栈启动的 PostgreSQL：改这里等于同时改建库参数与后端连接串
POSTGRES_DB=xihan_basicapp
POSTGRES_USER=xihan
POSTGRES_PASSWORD=change-me

# 后端密钥：UTF-8 至少 32 字节，部署前换成随机串；多实例必须一致
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
SIGNED_URLS_SECRET=change-me-to-another-random-string-of-32-bytes

# superadmin 的初始密码：首次执行种子时写入，登录后立即修改
SUPERADMIN_PASSWORD=SuperAdmin@123

# 是否写演示数据（演示租户 demo 及其组织、角色与访问策略等）
ENABLE_DEMO_DATA=false

# 宿主机端口
FRONTEND_PORT=8080
BACKEND_PORT=9710
