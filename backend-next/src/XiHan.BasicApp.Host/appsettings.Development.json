{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "XiHan": "Debug"
    }
  },
  "XiHan": {
    "Bindings": {
      "db": {
        "value": "Host=127.0.0.1;Port=5432;Database=xihan_basicapp_next;Username=postgres;Password=postgres"
      }
    },
    "Persistence": {
      "SqlSugar": {
        "InitTables": true
      }
    },
    "ObjectStorage": {
      "SignedUrls": {
        "Secret": "development-only-signed-url-secret-change-before-any-deployment"
      }
    },
    "Security": {
      "Jwt": {
        "Secret": "development-only-jwt-secret-change-before-any-deployment"
      }
    }
  },
  "BasicApp": {
    "Seed": {
      "EnableDemoData": true
    }
  }
}
