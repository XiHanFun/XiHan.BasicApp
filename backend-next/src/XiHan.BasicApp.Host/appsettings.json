{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:9710"
      },
      "Grpc": {
        "Url": "http://127.0.0.1:9711",
        "Protocols": "Http2"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "XiHan": {
    "Kernel": {
      "StartTimeoutSeconds": 60,
      "StopTimeoutSeconds": 30,
      "FailurePolicy": "TerminateStartup"
    },
    "Bindings": {
      "db": {
        "type": "connection:relational",
        "value": "",
        "provider": "postgresql"
      }
    },
    "Persistence": {
      "SqlSugar": {
        "InitTables": false
      }
    },
    "Security": {
      "RoleClaim": "role",
      "Jwt": {
        "Secret": "",
        "Issuer": "xihan.basicapp",
        "Audience": "xihan.basicapp",
        "ClockSkewSeconds": 60
      }
    },
    "MultiTenancy": {
      "RequireTenant": false,
      "TenantClaim": "tenant"
    },
    "Localization": {
      "DefaultLocale": "en-US"
    },
    "Auditing": {
      "Selection": "Protected",
      "IncludeSuccesses": true
    },
    "Protocols": {
      "Http": {
        "RoutePrefix": "/api"
      },
      "Grpc": {
        "Package": "xihan.basicapp"
      },
      "Mcp": {
        "ServerName": "XiHan.BasicApp"
      }
    }
  },
  "BasicApp": {
    "ApiDocs": {},
    "Auth": {
      "AccessTokenMinutes": 120,
      "RefreshTokenDays": 7,
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15,
      "PasswordMinLength": 8,
      "PasswordHistoryDepth": 3,
      "SessionCacheSeconds": 30
    },
    "Seed": {
      "EnableDemoData": false,
      "SuperAdminPassword": ""
    }
  }
}
