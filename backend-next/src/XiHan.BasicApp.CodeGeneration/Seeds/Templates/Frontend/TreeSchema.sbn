{{~ has_import_date = false ~}}
{{~ for col in Columns ~}}
{{~ if col.InForm ~}}
{{~ has_form_field = true ~}}
{{~ end ~}}
{{~ end ~}}
{{~ can_create = CanCreate && has_form_field ~}}
{{~ can_update = CanUpdate && has_form_field ~}}
{{~ can_import = CanImport && can_create ~}}
{{~ for col in Columns ~}}
{{~ if can_import && col.IsImportable && (col.ControlKind == "date" || col.ControlKind == "datetime") ~}}
{{~ has_import_date = true ~}}
{{~ end ~}}
