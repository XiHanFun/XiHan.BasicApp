using {{ EntityNamespace }};
{{~ if unique ~}}
using XiHan.Framework.Domain.Specifications;
{{~ end ~}}
using XiHan.Framework.Kernel.Operations;
using XiHan.Framework.Persistence.Abstractions.Identifiers;
{{~ if unique ~}}
using XiHan.Framework.Persistence.Abstractions.Queries;
{{~ end ~}}
using XiHan.Framework.Persistence.Abstractions.Repositories;
using XiHan.Framework.Primitives;

namespace {{ Namespace }}.Operations.{{ ResourcePascal }};

/// <summary>
/// 新建{{ DisplayName | xml_doc }}。
/// </summary>
/// <remarks>
/// <c>POST /api/{{ Resource }}</c>。{{ for col in CreateUniqueColumns }}{{ col.Label | xml_doc }}租户内唯一；{{ end }}{{ if parent }}上级要存在；{{ end }}写入当前租户。
/// </remarks>
/// <param name="repository">仓储。</param>
/// <param name="ids">标识生成器。</param>
[Operation(Id, Stability = Stability.Preview, Expose = Expose.Http, Permission = {{ ModuleName }}Permissions.{{ ResourcePascal }}Create)]
public sealed class Create{{ ClassName }}(IRepository<{{ ClassName }}, Guid> repository, IIdGenerator<Guid> ids) : IOperation<Create{{ ClassName }}Request, {{ ClassName }}Response>
{
    /// <summary>
    /// 操作 ID。
    /// </summary>
    public const string Id = "{{ Resource }}.create";

    /// <inheritdoc />
    public async ValueTask<Result<{{ ClassName }}Response>> HandleAsync(Create{{ ClassName }}Request request, InvocationContext context)
    {
        ArgumentNullException.ThrowIfNull(request);
        ArgumentNullException.ThrowIfNull(context);
{{~ for col in CreateUniqueColumns ~}}
        var {{ col.Field }}Value = request.{{ col.CSharpProperty }}{{ if col.IsString }}{{ if col.IsNullableType }}?{{ end }}.Trim(){{ end }};
        if ({{ if col.IsString }}!string.IsNullOrEmpty({{ col.Field }}Value) && {{ else if col.IsNullableType }}{{ col.Field }}Value is not null && {{ end }}await repository.CountAsync(EntityQuery.All<{{ ClassName }}>().Where(new Specification<{{ ClassName }}>(e => e.{{ col.CSharpProperty }} == {{ col.Field }}Value)), context.CancellationToken).ConfigureAwait(false) > 0)
        {
            return Error.Conflict({{ ModuleName }}Errors.{{ ClassName }}{{ col.CSharpProperty }}Taken, {{ ModuleName }}Messages.{{ ClassName }}{{ col.CSharpProperty }}Taken, MessageArguments.Of(("value", {{ col.Field }}Value)));
        }

{{~ end ~}}
{{~ if parent ~}}
        var parentId = request.{{ TreeParentColumn.CSharpProperty }}{{ if TreeParentColumn.IsNullableType }} ?? Guid.Empty{{ end }};
        if (parentId != Guid.Empty && !(await repository.FindAsync(parentId, context.CancellationToken).ConfigureAwait(false)).HasValue)
        {
            return Error.Validation({{ ModuleName }}Errors.{{ ClassName }}InvalidParent, {{ ModuleName }}Messages.{{ ClassName }}InvalidParent, MessageArguments.Of(("id", parentId)));
        }

{{~ end ~}}
        var entity = request.ToEntity(ids.NewId());
        var added = await repository.AddAsync(entity, context.CancellationToken).ConfigureAwait(false);
        return added.IsFailure ? added.Error! : {{ ClassName }}Response.From(entity);
    }
}
{{~ end ~}}
