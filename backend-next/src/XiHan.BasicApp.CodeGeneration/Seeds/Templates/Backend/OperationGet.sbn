using {{ EntityNamespace }};
using XiHan.Framework.Kernel.Operations;
using XiHan.Framework.Persistence.Abstractions.Repositories;
using XiHan.Framework.Primitives;

namespace {{ Namespace }}.Operations.{{ ResourcePascal }};

/// <summary>
/// {{ DisplayName | xml_doc }}详情。
/// </summary>
/// <remarks>
/// <c>GET /api/{{ Resource }}/{id}</c>。
/// </remarks>
/// <param name="repository">仓储。</param>
[Operation(Id, Stability = Stability.Preview, Expose = Expose.Http, Permission = {{ ModuleName }}Permissions.{{ ResourcePascal }}Read)]
public sealed class Get{{ ClassName }}(IRepository<{{ ClassName }}, Guid> repository) : IOperation<Get{{ ClassName }}Request, {{ ClassName }}Response>
{
    /// <summary>
    /// 操作 ID。
    /// </summary>
    public const string Id = "{{ Resource }}.get";

    /// <inheritdoc />
    public async ValueTask<Result<{{ ClassName }}Response>> HandleAsync(Get{{ ClassName }}Request request, InvocationContext context)
    {
        ArgumentNullException.ThrowIfNull(request);
        ArgumentNullException.ThrowIfNull(context);
        return (await repository.FindAsync(request.Id, context.CancellationToken).ConfigureAwait(false)).TryGetValue(out var entity)
            ? {{ ClassName }}Response.From(entity)
            : Error.NotFound({{ ModuleName }}Errors.{{ ClassName }}NotFound, {{ ModuleName }}Messages.{{ ClassName }}NotFound, MessageArguments.Of(("id", request.Id)));
    }
}
