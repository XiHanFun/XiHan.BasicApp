using {{ Namespace }}.Queries;
using XiHan.BasicApp.Contracts.Paging;
using XiHan.Framework.Kernel.Operations;
using XiHan.Framework.Primitives;

namespace {{ Namespace }}.Operations.{{ ResourcePascal }};

/// <summary>
/// {{ DisplayName | xml_doc }}列表。
/// </summary>
/// <remarks>
/// <c>POST /api/{{ Resource }}:list</c>（分页、关键字、筛选、排序），筛选与排序的白名单见 <see cref="{{ ClassName }}Queries"/>。
/// </remarks>
/// <param name="queries">列表查询。</param>
[Operation(Id, Stability = Stability.Preview, Expose = Expose.Http, Permission = {{ ModuleName }}Permissions.{{ ResourcePascal }}Read)]
public sealed class List{{ ResourcePascal }}({{ ClassName }}Queries queries) : IOperation<PageRequest, PageResult<{{ ClassName }}Response>>
{
    /// <summary>
    /// 操作 ID。
    /// </summary>
    public const string Id = "{{ Resource }}.list";

    /// <inheritdoc />
    public ValueTask<Result<PageResult<{{ ClassName }}Response>>> HandleAsync(PageRequest request, InvocationContext context)
    {
        ArgumentNullException.ThrowIfNull(request);
        ArgumentNullException.ThrowIfNull(context);
        return queries.ListAsync(request, context);
    }
}
