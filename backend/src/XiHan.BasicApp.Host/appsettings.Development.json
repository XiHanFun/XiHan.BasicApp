// 开发环境配置，叠加在 appsettings.json 之上，只写不同的键
// 连接串与密钥都是本机开发用的公开值，不能用于任何部署环境；本机不同时用用户机密或环境变量覆盖
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "XiHan": "Debug"
    }
  },

  "XiHan": {
    "Bindings": {
      // 本机 PostgreSQL，库不存在时启动自动建
      "db": {
        "type": "connection:relational",
        "value": "Host=127.0.0.1;Port=5432;Database=xihan_basicapp;Username=postgres;Password=postgres",
        "provider": "postgresql"
      }
      // 本机 Redis、RabbitMQ：打开后连不上启动即失败
      // "cache": { "type": "cache:distributed", "value": "127.0.0.1:6379" },
      // "queue": { "type": "queue", "value": "amqp://guest:guest@127.0.0.1:5672" }
    },

    "Persistence": {
      "SqlSugar": {
        "InitTables": true
      }
    },

    "ObjectStorage": {
      "SignedUrls": {
        "Secret": "development-only-signed-url-secret-change-before-any-deployment"
      }
    },

    "Security": {
      "Jwt": {
        "Secret": "development-only-jwt-secret-change-before-any-deployment"
      },
      // 本机的模型端点、MinIO 与 Webhook 调试服务
      "Outbound": {
        "AllowLoopback": true
      },
      // 开发服务器 9100 与端到端冒烟 9130
      "WebAuthn": {
        "RelyingPartyId": "localhost",
        "Origins": ["http://localhost:9100", "http://localhost:9130"]
      }
    }

    // 本机 OpenTelemetry Collector
    // "Observability": {
    //   "OpenTelemetry": {
    //     "Otlp": { "Endpoint": "http://localhost:4317" }
    //   }
    // }
  },

  "BasicApp": {
    "ApiDocs": {
      "Enabled": true
    },

    // 第三方登录的凭据用 dotnet user-secrets 写，不入库
    "Auth": {
      "SelfRegistrationEnabled": true,
      "OAuth": {
        "CallbackBaseUrl": "http://localhost:9100"
      }
    },

    "Schema": {
      "CreateDatabase": true
    },
    // superadmin 的初始密码是开发用的公开值
    "Seed": {
      "RunOnStartup": true,
      "EnableDemoData": true,
      "SuperAdminPassword": "SuperAdmin@123"
    },

    "CodeGeneration": {
      "EnableGenerateToProject": true,
      "AllowSqliteDataSource": true,
      "BackendRootPath": "../..",
      "FrontendRootPath": "../../../frontend"
    }

    // 本机 Qdrant（docker run -p 6334:6334 qdrant/qdrant）
    // "AI": {
    //   "Qdrant": { "Host": "localhost", "Port": 6334 }
    // }
  }
}
