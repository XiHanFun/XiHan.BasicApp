// XiHan.BasicApp 宿主配置：开发环境（ASPNETCORE_ENVIRONMENT=Development）
//
// 叠加在 appsettings.json 之上，只写与公共配置不同的键；键的含义见 appsettings.json 里的注释
// 这里的连接串、密钥与密码都是本机开发用的占位值，不能用于任何部署环境
// 本机账号不同时不要改这个文件，用用户机密或环境变量覆盖，如 XiHan__Bindings__db__value
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      // 框架日志开到 Debug，便于看特性装配、管道与 SQL 之外的框架行为
      "XiHan": "Debug"
    }
  },

  "XiHan": {
    // 服务绑定：开发库与可选的本机 Redis、RabbitMQ
    "Bindings": {
      // 本机 PostgreSQL 的 xihan_basicapp 库，先建库再启动（见 docs/dev-environment.md）
      "db": {
        "type": "connection:relational",
        "value": "Host=127.0.0.1;Port=5432;Database=xihan_basicapp;Username=postgres;Password=postgres",
        "provider": "postgresql"
      }
      // 本机 Redis：打开后单机也走 Redis 共享缓存与两级缓存，用于验证多实例行为；连不上启动即失败
      // "cache": { "type": "cache:distributed", "value": "127.0.0.1:6379" },
      // 本机 RabbitMQ：打开后发件箱与广播订阅经它派发；连不上启动即失败
      // "queue": { "type": "queue", "value": "amqp://guest:guest@127.0.0.1:5672" }
    },

    // 开发库按实体建缺表、加缺列，改了实体重启即生效
    "Persistence": {
      "SqlSugar": {
        "InitTables": true
      }
    },

    // 本地签名下载地址的开发用密钥
    "ObjectStorage": {
      "SignedUrls": {
        "Secret": "development-only-signed-url-secret-change-before-any-deployment"
      }
    },

    "Security": {
      // 开发用的 JWT 密钥
      "Jwt": {
        "Secret": "development-only-jwt-secret-change-before-any-deployment"
      },
      // 放行回环地址：本机的模型端点、MinIO、Webhook 调试服务都在 localhost 上
      "Outbound": {
        "AllowLoopback": true
      }
    }

    // 本机 OpenTelemetry Collector（如 Aspire Dashboard、Jaeger）；不配即不导出
    // "Observability": {
    //   "OpenTelemetry": {
    //     "Otlp": { "Endpoint": "http://localhost:4317" }
    //   }
    // }
  },

  "BasicApp": {
    // 接口文档：开发环境缺省就开，这里写明
    "ApiDocs": {
      "Enabled": true
    },

    // 自助注册：开发环境打开，便于试注册页；注册的是平台账号、不带任何角色
    // 第三方登录：回调走前端开发服务器（它把 /api 代理到后端），回来后落在前端页面；
    // 提供商凭据不入库，用 dotnet user-secrets 写 BasicApp:Auth:OAuth:Providers:<序号>:Name / ClientId / ClientSecret
    "Auth": {
      "SelfRegistrationEnabled": true,
      "OAuth": {
        "CallbackBaseUrl": "http://localhost:9100"
      }
    },

    // 开发库不存在时启动先建库，克隆下来不用先手工建库（本机 postgres 账号有建库权限）
    "Schema": {
      "CreateDatabase": true
    },
    // 每次启动执行一遍种子，首次运行即可用 superadmin 登录；开发库写演示数据；superadmin 的初始密码是开发用的公开值
    "Seed": {
      "RunOnStartup": true,
      "EnableDemoData": true,
      "SuperAdminPassword": "SuperAdmin@123"
    },

    // 代码生成：允许生成到本仓库的 backend 与 frontend，开放 SQLite 数据源便于本机试用
    "CodeGeneration": {
      "EnableGenerateToProject": true,
      "AllowSqliteDataSource": true,
      "BackendRootPath": "../..",
      "FrontendRootPath": "../../../frontend"
    }

    // 本机 Qdrant（docker run -p 6334:6334 qdrant/qdrant），打开后知识库可用
    // "AI": {
    //   "Qdrant": { "Host": "localhost", "Port": 6334 }
    // }
  }
}
