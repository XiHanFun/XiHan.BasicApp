// 覆盖顺序：本文件 → appsettings.{环境}.json → 用户机密 → 环境变量（双下划线分节，如 XiHan__Security__Jwt__Secret）→ 命令行
// 每项说明见 ConfigurationSchema.json 与 docs/configuration.md；注释掉的是可选项，密钥留空、部署时用环境变量提供
{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:9710"
      },
      "Grpc": {
        "Url": "http://127.0.0.1:9711",
        "Protocols": "Http2"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
      // "XiHan": "Debug"
    }
  },

  "AllowedHosts": "*",

  "XiHan": {
    "Kernel": {
      "StartTimeoutSeconds": 60,
      "StopTimeoutSeconds": 30,
      "FailurePolicy": "TerminateStartup",
      "UseBuiltInMiddleware": true,

      "Resilience": {
        // "PermitLimit": 100,
        "WindowSeconds": 1,
        "QueueLimit": 0,
        // "ConcurrencyLimit": 16,
        "ConcurrencyQueueLimit": 0,
        // "FailureThreshold": 5,
        "BreakSeconds": 30
        // "Operations": {
        //   "auth.login": { "PermitLimit": 20, "WindowSeconds": 1 }
        // }
      }
    },

    // 服务绑定不写在这里：开发写 appsettings.Development.json，部署用环境变量 XiHan__Bindings__db__value 或 Service Binding
    // "Bindings": {
    //   "db": { "type": "connection:relational", "value": "Host=<主机>;Port=5432;Database=<库名>;Username=<用户>;Password=<密码>", "provider": "postgresql" },
    //   "cache": { "type": "cache:distributed", "value": "<主机>:6379", "password": "<密码>" },
    //   "queue": { "type": "queue", "value": "amqp://<主机>:5672", "username": "<用户>", "password": "<密码>" }
    // },

    "Persistence": {
      "SqlSugar": {
        "InitTables": false,
        "CommandTimeoutSeconds": 300,
        "HealthProbeIntervalSeconds": 15,
        // "Connections": {
        //   "leases": "Data Source=App_Data/leases.db"
        // },
        "Replicas": {
          "DefaultHitRate": 10,
          "HealthCheck": true,
          "HealthCheckIntervalSeconds": 30,
          "FailureCooldownSeconds": 120
        }
      },
      "DataSources": {
        "MaxCount": 64,
        "HealthProbeIntervalSeconds": 15
      }
    },

    "Caching": {
      "InMemory": {
        "MaxEntries": 10000,
        "DefaultTimeToLiveSeconds": 300
      },
      "Idempotency": {
        "TimeToLiveSeconds": 86400,
        "InProgressTimeToLiveSeconds": 60
      }
      // "Redis": {
      //   "Configuration": "<主机>:6379,password=<密码>",
      //   "KeyPrefix": "xihan:",
      //   "PublishChanges": true,
      //   "DefaultTimeToLiveSeconds": 300,
      //   "HealthProbeIntervalSeconds": 15
      // },
      // "Hybrid": {
      //   "LocalCapacity": 10000,
      //   "LocalTimeToLiveSeconds": 30
      // }
    },

    "Messaging": {
      "MaxAttempts": 3,
      "DeadLetterSuffix": ".dlq",
      // "InstanceId": "basicapp-0",
      "InMemory": {
        "MaxQueuedMessages": 10000
      },
      "Outbox": {
        "PollIntervalSeconds": 1,
        "BatchSize": 100,
        "MaxAttempts": 10,
        "RetryDelaySeconds": 5,
        "MaxRetryDelaySeconds": 300,
        "DispatchedRetentionSeconds": 86400,
        "IncludeShards": false
        // "ShardRefreshIntervalSeconds": 60
      }
      // "RabbitMQ": {
      //   "Configuration": "amqp://<用户>:<密码>@<主机>:5672",
      //   "QueuePrefix": "xihan.",
      //   "Exchange": "xihan",
      //   "PrefetchCount": 16,
      //   "HealthProbeIntervalSeconds": 15
      // }
    },

    "ObjectStorage": {
      "StoreHealthProbeIntervalSeconds": 15,
      "SignedUrls": {
        "Secret": "",
        "BaseUrl": "/blobs"
      }
      // "FileSystem": {
      //   "RootPath": "blobs",
      //   "MaxTotalBytes": 1073741824,
      //   "MaxBlobBytes": 268435456,
      //   "MultipartExpiryHours": 168,
      //   "MaxMultipartUploads": 1000
      // },
      // "Stores": {
      //   "archive": { "Provider": "filesystem", "RootPath": "/data/archive" }
      // }
    },

    "Security": {
      "RequireAuthentication": false,
      "RoleClaim": "role",
      "Jwt": {
        "Secret": "",
        "Issuer": "xihan.basicapp",
        "Audience": "xihan.basicapp",
        "ClockSkewSeconds": 60,
        "NameClaim": "sub"
      },
      "Database": {
        "CacheSize": 10000,
        "CacheTimeToLiveSeconds": 30
      },
      "Ip2Region": {
        "V4Database": "IpDatabases/ip2region_v4.xdb",
        "V6Database": "IpDatabases/ip2region_v6.xdb"
      },
      "WebAuthn": {
        "RelyingPartyId": "",
        "RelyingPartyName": "XiHan BasicApp",
        "UserVerification": "Required",
        "ResidentKey": "Required",
        "TimeoutSeconds": 300,
        "ChallengeSize": 32
        // "Origins": ["https://admin.example.com"]
      },
      "Outbound": {
        "AllowLoopback": false,
        "AllowPrivateNetwork": false
        // "AllowedNetworks": ["10.1.0.0/16"],
        // "AllowedHosts": ["minio"]
      }
    },

    "MultiTenancy": {
      "RequireTenant": false,
      "ValidateAgainstStore": true,
      "TenantClaim": "tenant",
      "ShardCacheSize": 10000,
      "ShardCacheTimeToLiveSeconds": 30,
      // "DefaultTenant": "<租户 ID>",
      "Database": {
        "CacheSize": 10000,
        "CacheTimeToLiveSeconds": 30,
        "MaxListedTenants": 10000
      }
    },

    "Localization": {
      "Locales": "en-US,zh-CN,zh-TW,ja-JP,ko-KR,de-DE,es-ES,fr-FR,pt-BR,ru-RU",
      "DefaultLocale": "en-US",
      "Database": {
        "RefreshIntervalSeconds": 300,
        "MaxTranslations": 100000
      }
    },

    "Auditing": {
      "Selection": "None",
      "IncludeSuccesses": true,
      // "Exclude": ["profile.*"],
      "Database": {
        "QueueCapacity": 10000,
        "BatchSize": 100,
        "FlushIntervalSeconds": 1,
        "LogEvents": true
      }
    },

    "Scheduling": {
      "PollIntervalSeconds": 1,
      "MaxConcurrentRuns": 32,
      "AcquireBatchSize": 16,
      "MisfireThresholdSeconds": 60,
      "LeaseResource": "scheduling.jobs",
      "LeaseTimeToLiveSeconds": 30,
      "NodeTimeoutSeconds": 90,
      "HousekeepingIntervalSeconds": 60,
      "HistoryRetentionDays": 7,
      // "NodeId": "node-1",
      "Database": {
        "HealthProbeIntervalSeconds": 15
      }
    },

    "Workflow": {
      "MaxNodeExecutionsPerBurst": 1000,
      "MaxSubWorkflowDepth": 16,
      "LockTimeoutSeconds": 10,
      "NotResumableBackoffSeconds": 300,
      "ExpressionCacheSize": 10000,
      "RetentionDays": 0,
      "HousekeepingIntervalSeconds": 3600,
      "HttpTimeoutSeconds": 30,
      "MaxHttpTimeoutSeconds": 300,
      "MaxForEachItems": 1000,
      "MaxVariablesBytes": 8388608,
      "Database": {
        "PollIntervalSeconds": 1,
        "BatchSize": 100,
        "LockLeaseSeconds": 60,
        "HealthProbeIntervalSeconds": 15
        // "HolderId": "workflow-node-1",
        // "LockConnection": "leases"
      }
    },

    "AI": {
      "Knowledge": {
        // "EmbeddingProvider": "<提供商名称>",
        // "PromptName": "rag",
        "Dimensions": 1536,
        "ChunkSize": 1000,
        "ChunkOverlap": 100,
        "Top": 5,
        "Collection": "knowledge"
      },
      "Guardrails": {
        "Enabled": false,
        "UseBuiltInInjectionHeuristics": true
        // "BlockedKeywords": ["<关键词>"],
        // "InjectionPatterns": ["ignore\\s+previous"]
      },
      // "Tools": {
      //   "users.list": "list_users"
      // },
      // "Prompts": {
      //   "rag": { "Template": "根据资料回答问题。\n资料：{context}\n问题：{question}", "Description": "知识库问答" }
      // },
      "VectorData": {
        "HealthProbeIntervalSeconds": 15
      }
    },

    "Observability": {
      "Host": {
        "SampleIntervalSeconds": 5
      },
      "OpenTelemetry": {
        // "ServiceName": "xihan-basicapp",
        // "ServiceVersion": "6.0.0",
        "Tracing": true,
        "Metrics": true,
        "Logging": true,
        "Console": false,
        "SamplingRatio": 1
        // "Sources": "MyCompany.Orders",
        // "Meters": "MyCompany.Orders",
        // "Otlp": {
        //   "Enabled": true,
        //   "Endpoint": "http://localhost:4317",
        //   "Protocol": "Grpc"
        // }
      }
    },

    "Protocols": {
      "Http": {
        "RoutePrefix": "/api",
        "MaxRequestBodyBytes": 4194304
        // "Routes": {
        //   "<操作 ID>": "POST /<路径>"
        // }
      },
      "Grpc": {
        "Package": "xihan.basicapp"
        // "Methods": {
        //   "users.get": "Users/Get"
        // }
      },
      "Mcp": {
        "ServerName": "XiHan.BasicApp",
        "MaxRequestBodyBytes": 4194304
        // "AllowedOrigins": ["https://admin.example.com"],
        // "ServerVersion": "6.0.0",
        // "Instructions": "<使用说明>",
        // "Tools": {
        //   "users.list": "users_list"
        // }
      },
      "CloudEvents": {
        "Inbound": "Dispatch",
        "Outbound": "Binary",
        "PropagateTraceContext": false,
        "MaxRequestBodyBytes": 1048576,
        "MaxBatchSize": 100,
        "AcceptUnmappedTypes": false
        // "Topics": {
        //   "com.example.order.created": "orders.created"
        // },
        // "Webhooks": {
        //   "orders.created": "https://hooks.example.com/orders"
        // }
      }
    }
  },

  "BasicApp": {
    "Database": {
      "Replicas": [
        // { "ConnectionString": "Host=<从库主机>;Port=5432;Database=<库名>;Username=<用户>;Password=<密码>", "HitRate": 10 }
      ],
      "LogSql": false,
      "LogSqlErrors": true,
      "LogSlowSql": true,
      "SlowSqlThresholdMilliseconds": 1000
    },

    "Schema": {
      "AutoUpgrade": true,
      "CreateDatabase": false,
      // "Directory": "Schema",
      "LockExpiryMinutes": 30,
      "LockWaitMinutes": 10
    },

    "Seed": {
      "RunOnStartup": false,
      "EnableDemoData": false,
      "SuperAdminPassword": ""
    },

    "Modules": {
      "Workbench": { "Enabled": true },
      "Printing": { "Enabled": true },
      "Chat": { "Enabled": true },
      "Workflow": { "Enabled": true },
      "CodeGeneration": { "Enabled": true },
      "AI": { "Enabled": true }
    },

    "ApiDocs": {
      // "Enabled": false
    },

    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    },

    "Cors": {
      "AllowedOrigins": [],
      "AllowAnyOrigin": false,
      "AllowAnyMethod": true,
      "AllowedMethods": [],
      "AllowAnyHeader": true,
      "AllowedHeaders": [],
      "AllowCredentials": true,
      "ExposedHeaders": [],
      "PreflightMaxAgeSeconds": 0
    },

    "CloudEvents": {
      "Enabled": false
    },

    "DataProtection": {
      // "KeysDirectory": "/var/lib/xihan-basicapp/keys"
    },

    "Auth": {
      "AccessTokenMinutes": 120,
      "RefreshTokenDays": 7,
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15,
      "PasswordMinLength": 8,
      "PasswordHistoryDepth": 3,
      "SessionCacheSeconds": 30,
      "CaptchaEnabled": true,
      "CaptchaSeconds": 300,
      "LoginThrottleWindowSeconds": 60,
      "LoginThrottleAccountLimit": 5,
      "LoginThrottleIpLimit": 30,
      "TwoFactorTicketMinutes": 10,
      "TwoFactorTicketMaxFailures": 5,
      "TotpIssuer": "XiHan BasicApp",
      "SelfRegistrationEnabled": false,
      "VerificationCodeMinutes": 10,
      "VerificationCodeIntervalSeconds": 60,
      "VerificationCodeDailyPerTarget": 10,
      "VerificationCodeDailyPerAddress": 50,
      "VerificationCodeMaxFailures": 5,
      "VerificationCodeLockoutMinutes": 10,

      "OAuth": {
        "Enabled": true,
        "FrontendCallbackUrl": "/#/auth/oauth-callback",
        // "CallbackBaseUrl": "https://<后端对外地址>",
        "Providers": [
          // { "Name": "github", "ClientId": "<客户端 ID>", "ClientSecret": "<客户端密钥>" },
          // { "Name": "gitee", "ClientId": "<客户端 ID>", "ClientSecret": "<客户端密钥>" },
          // { "Name": "google", "ClientId": "<客户端 ID>", "ClientSecret": "<客户端密钥>" },
          // { "Name": "qq", "ClientId": "<APP ID>", "ClientSecret": "<APP Key>" },
          // { "Name": "wechat", "ClientId": "<appid>", "ClientSecret": "<secret>", "Mode": "QrCode" },
          // { "Name": "wecom", "ClientId": "<corpid>", "ClientSecret": "<应用 secret>", "AgentId": "<AgentId>", "Mode": "QrCode", "LoadMemberProfile": true },
          // { "Name": "lark", "ClientId": "<App ID>", "ClientSecret": "<App Secret>", "DisplayName": "飞书" },
          // { "Name": "dingtalk", "ClientId": "<AppKey>", "ClientSecret": "<AppSecret>", "CorpId": "<corpId>" }
        ]
      }
    },

    "Access": {
      "PermissionConditionMode": "Enforce",
      "AccessPolicyEnabled": true,
      "ConditionTimeZone": "Asia/Shanghai"
    },

    "Auditing": {
      "QueueCapacity": 10000,
      "BatchSize": 200,
      "FlushIntervalSeconds": 1,
      "AccessLog": {
        "Enabled": true,
        "Exclude": []
      },
      "DefaultRetentionDays": 180,
      "RetentionCron": "0 3 * * *"
    },

    "Files": {
      "LocalRootPath": "App_Data/files",
      "MaxUploadBytes": 104857600,
      "UploadPartBytes": 8388608,
      "UploadLifetime": "1.00:00:00",
      "LinkLifetime": "00:30:00",
      "MaxLinkLifetime": "7.00:00:00"
    },

    "Notification": {
      // "Brand": "XiHan.BasicApp",
      "DispatchInterval": "00:00:05",
      "RetryDelay": "00:00:30",
      "MaxAttempts": 3,
      "StuckAfter": "00:10:00",

      "Telegram": {
        "MaxDispatchConcurrency": 16,
        "DedupLifetime": "00:30:00",
        "PollingTimeoutSeconds": 50,
        "Texts": {
          "StartReply": "你好，欢迎使用 {botUsername}！发送 /help 查看可用命令。",
          "HelpTitle": "可用命令：",
          "MyIdReply": "ChatId：{chatId}\nUserId：{userId}",
          "CommandDisabledReply": "该命令未开启。",
          "CommandAdminOnlyReply": "该命令仅管理员可用。",
          "CallbackAdminOnlyReply": "该操作仅管理员可用。",
          "FallbackReply": "暂不支持处理该消息，发送 /help 查看可用命令。",
          "InternalErrorReply": "处理消息时出错，请稍后再试。",
          "SendFailureAdminNotifyTitle": "消息发送失败告警",
          "StartDescription": "开始使用机器人",
          "HelpDescription": "查看帮助",
          "MyIdDescription": "查看我的 Telegram Id"
        },
        "Retry": {
          "MaxRetries": 3,
          "BaseDelayMs": 500,
          "MaxDelayMs": 10000,
          "MaxRetryAfterSeconds": 60,
          "NotifyAdminOnFinalFailure": true
        }
      }
    },

    "Realtime": {
      "SignalR": {
        "EnableDetailedErrors": false,
        "KeepAliveInterval": "00:00:15",
        "ClientTimeoutInterval": "00:00:30",
        "HandshakeTimeout": "00:00:15",
        "MaximumReceiveMessageSize": 32768,
        "StreamBufferCapacity": 10,
        "MaximumParallelInvocationsPerClient": 1
      },
      "Presence": {
        "OfflineGrace": "00:00:08"
      }
    },

    "OpenPlatform": {
      "TimestampToleranceSeconds": 300,
      "MaxRequestBodyBytes": 2097152,
      // "Issuer": "https://admin.example.com/api/oauth2",
      "ConsentPageUrl": "/#/oauth/authorize",
      "IdTokenLifetimeSeconds": 600
    },

    "CodeGeneration": {
      "TablePrefixes": "sys_",
      "EnableGenerateToProject": false,
      "AllowSqliteDataSource": false
      // "BackendRootPath": "../..",
      // "FrontendRootPath": "../../../frontend"
    },

    "AI": {
      "Qdrant": {
        // "Host": "localhost",
        // "Port": 6334,
        // "Https": false,
        // "ApiKey": "<API 密钥>"
      }
    }
  }
}
