// XiHan.BasicApp 宿主配置：所有环境共用
//
// 加载顺序（后者覆盖前者）：appsettings.json → appsettings.{环境}.json → 用户机密（仅 Development）→ 环境变量 → 命令行参数
// 环境由 ASPNETCORE_ENVIRONMENT 决定：本机开发是 Development（launchSettings.json 已设好），部署时缺省是 Production
// 环境变量用双下划线分节，如 XiHan__Security__Jwt__Secret、BasicApp__Auth__AccessTokenMinutes；数组写下标，如 BasicApp__Cors__AllowedOrigins__0
//
// 读这份文件：
// - 写出来的值就是代码里的缺省值（个别是 BasicApp 的推荐值，注释里有说明），改之前先看注释
// - 被注释掉的键是可选项：要用时去掉行首的 //，填上真实值；不写时的行为见注释
// - 密钥（JWT、签名地址、数据库连接、第三方登录凭据）在这里一律留空或只写占位符，部署时用环境变量或密钥存储提供，不要提交到仓库
// - 只在开发环境生效的值写在 appsettings.Development.json
// 完整说明见 docs/configuration.md
{
  // ============================================================================================
  // ASP.NET Core
  // ============================================================================================
  // 监听地址
  "Kestrel": {
    "Endpoints": {
      // HTTP：操作接口、OpenAPI、MCP、SignalR Hub 与文件端点
      // 容器或对外部署时改成 http://0.0.0.0:9710（或用环境变量 Kestrel__Endpoints__Http__Url 覆盖），HTTPS 由反向代理终止
      "Http": {
        "Url": "http://localhost:9710"
      },
      // gRPC（HTTP/2）：只供内部服务调用，只监听内网地址，不要经反向代理暴露到公网
      "Grpc": {
        "Url": "http://127.0.0.1:9711",
        "Protocols": "Http2"
      }
    }
  },

  // 日志级别：键是日志类别前缀（取最长匹配），值为 Trace、Debug、Information、Warning、Error、Critical、None
  // 日志同时经 OpenTelemetry 导出，见 XiHan:Observability:OpenTelemetry
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      // ASP.NET Core 自身的请求日志较多，只记警告以上
      "Microsoft.AspNetCore": "Warning"
      // 框架日志；排查问题时可调到 Debug（开发环境已调）
      // "XiHan": "Debug"
    }
  },

  // 主机过滤：允许的 Host 请求头，分号分隔，* 为不限制
  "AllowedHosts": "*",

  // ============================================================================================
  // XiHan：框架节，由 XiHan.Framework 的各个 Feature 读取
  // 全部是显式读取、写了就校验：类型、范围或枚举值不合法时启动即失败
  // 列表与字典（Exclude、Routes、AllowedHosts 等）没有内容时整项不要写：空的 [] 或 {} 会被 .NET 读成空字符串，
  // 校验时当成写错了的单个值而启动失败，所以下面这类项都以注释形式给出示例
  // ============================================================================================
  "XiHan": {
    // ------------------------------------------------------------------------------------------
    // 内核：特性的启停时限与失败策略
    // ------------------------------------------------------------------------------------------
    "Kernel": {
      // 单个特性的启动超时（秒）；框架缺省 30，BasicApp 取 60：表结构升级与开发环境建表都在启动阶段完成
      "StartTimeoutSeconds": 60,
      // 单个特性的停止超时（秒）
      "StopTimeoutSeconds": 30,
      // 特性启动失败时：TerminateStartup 终止启动，IsolateFeature 隔离该特性继续启动
      "FailurePolicy": "TerminateStartup",
      // 是否自动加入内核的内置中间件：观测、截止时间、韧性与输入校验；关掉后这四样连同下面的韧性策略都不生效，不要关
      "UseBuiltInMiddleware": true,

      // ----------------------------------------------------------------------------------------
      // 韧性：按操作 ID 的固定窗口限流、并发上限与熔断；缺省不限流、不限并发、不熔断
      // 根上的键是全部操作的默认策略，Operations:<操作 ID> 按操作覆盖
      // ----------------------------------------------------------------------------------------
      "Resilience": {
        // 固定窗口内允许的调用数（正整数）；不写不限流
        // "PermitLimit": 100,
        // 限流窗口（秒）
        "WindowSeconds": 1,
        // 窗口用尽时最多排队等待的调用数；0 为直接拒绝
        "QueueLimit": 0,
        // 同时执行的调用数上限（正整数）；不写不限
        // "ConcurrencyLimit": 16,
        // 并发用尽时最多排队等待的调用数；0 为直接拒绝
        "ConcurrencyQueueLimit": 0,
        // 连续失败多少次后熔断（正整数）；不写不熔断
        // "FailureThreshold": 5,
        // 熔断后拒绝调用的时长（秒），到期放一次试探
        "BreakSeconds": 30
        // 按操作覆盖，键为操作 ID（运行 `dotnet run ... -- operations` 列出全部），子键同上，不写的沿用默认策略
        // "Operations": {
        //   "auth.login": { "PermitLimit": 20, "WindowSeconds": 1 }
        // }
      }
    },

    // ------------------------------------------------------------------------------------------
    // 服务绑定：平台库 db（必需）、Redis 缓存 cache 与 RabbitMQ 消息 queue（可选）
    // 框架先读 SERVICE_BINDING_ROOT 目录（Kubernetes Service Binding），再读这一节；
    // 这一节里的同名绑定会整个盖掉目录里挂进来的（值为空也一样），所以本文件不写任何绑定：
    // 本机开发写在 appsettings.Development.json，部署用环境变量（XiHan__Bindings__db__value）或 Service Binding
    // 绑定名与属性名区分大小写，一律小写：db、cache、queue、type、value、provider、username、password
    // ------------------------------------------------------------------------------------------
    // "Bindings": {
    //   // 平台库，启动硬要求，缺失即 RUNTIME_VALIDATION_001 中断启动；provider 不写即 postgresql，口令写在连接串里
    //   "db": { "type": "connection:relational", "value": "Host=<主机>;Port=5432;Database=<库名>;Username=<用户>;Password=<密码>", "provider": "postgresql" },
    //   // Redis：配了即装 Redis 共享缓存 + 两级缓存（多实例共享），连不上启动即失败；不配即单机内存缓存
    //   // 口令可以写进连接串，也可以单独放在 username / password 属性里（覆盖连接串里的）
    //   "cache": { "type": "cache:distributed", "value": "<主机>:6379", "password": "<密码>" },
    //   // RabbitMQ：配了即装消息代理（发件箱派发、CloudEvents 发布、广播订阅经它）；不配即单机内存消息；口令规则同 cache
    //   "queue": { "type": "queue", "value": "amqp://<主机>:5672", "username": "<用户>", "password": "<密码>" }
    // },

    // ------------------------------------------------------------------------------------------
    // 持久化（SqlSugar）
    // ------------------------------------------------------------------------------------------
    "Persistence": {
      "SqlSugar": {
        // 启动时按实体建缺表、加缺列（CodeFirst）；只用于开发，正式环境由 Schema/ 脚本管理
        "InitTables": false,
        // 语句超时（秒，正整数）
        "CommandTimeoutSeconds": 300,
        // 健康项 persistence.sqlsugar.database 的重探间隔与单次探测超时（秒）
        "HealthProbeIntervalSeconds": 15,
        // 命名连接：值是连接串，名字合 ^[a-z0-9][a-z0-9-]{0,63}$、不能是 default 或 shard
        // 目前只有 SQLite 上的工作流租约表需要（见 XiHan:Workflow:Database:LockConnection）
        // "Connections": {
        //   "leases": "Data Source=App_Data/leases.db"
        // },
        // 从库的权重与健康探测；从库本身在 BasicApp:Database:Replicas 配
        "Replicas": {
          // 没写权重的从库取的读权重（正整数）
          "DefaultHitRate": 10,
          // 是否周期探测从库：连不上的自动摘除、恢复后加回；关掉后宕机的从库照常接读流量
          "HealthCheck": true,
          // 探测间隔（秒）
          "HealthCheckIntervalSeconds": 30,
          // 从库最后一次失败之后，过了这么久（秒）并且探通才恢复读流量
          "FailureCooldownSeconds": 120
        }
      },
      // 运行时数据源（代码生成登记的外部数据库）
      "DataSources": {
        // 运行时数据源的登记数上限（1–1024）；满了再登记新名字即失败，不淘汰已有的
        "MaxCount": 64,
        // 健康项 persistence.datasource.<名> 的重探间隔与单次探测超时（秒）
        "HealthProbeIntervalSeconds": 15
      }
    },

    // ------------------------------------------------------------------------------------------
    // 缓存：不配 Redis 时用进程内缓存（单机）；配了绑定 cache 或 Redis:Configuration 即换成 Redis + 两级缓存
    // ------------------------------------------------------------------------------------------
    "Caching": {
      // 进程内缓存（没配 Redis 时生效）
      "InMemory": {
        // 每张表（字节存储、对象缓存各一张）的条目上限
        "MaxEntries": 10000,
        // 未指定过期时的存活时间（秒）
        "DefaultTimeToLiveSeconds": 300
      },
      // 幂等去重：已完成结果与处理中标记的保留时间
      "Idempotency": {
        // 已完成结果的保留时间（秒），缺省 24 小时
        "TimeToLiveSeconds": 86400,
        // 处理中标记的保留时间（秒），即处理器崩溃时的最长封锁
        "InProgressTimeToLiveSeconds": 60
      }
      // Redis（配了连接才生效）：ISharedCache、字节存储、分布式锁与幂等去重走 Redis
      // "Redis": {
      //   // StackExchange.Redis 连接串；绑定 cache 的值优先，没有绑定或其值为空时读本键
      //   // 这一节没有单独的用户名、密码键：口令写进连接串，或经绑定 cache 的 username / password 属性提供
      //   "Configuration": "<主机>:6379,password=<密码>",
      //   // 键前缀；同一个 Redis 给几套环境用时各取一个
      //   "KeyPrefix": "xihan:",
      //   // 写入与删除后向频道 <前缀>__changes 发通知，各实例据此失效本机 L1
      //   "PublishChanges": true,
      //   // 未指定过期时的存活时间（秒）
      //   "DefaultTimeToLiveSeconds": 300,
      //   // 健康项 caching.redis.connection 的重探间隔与单次探测超时（秒）
      //   "HealthProbeIntervalSeconds": 15
      // },
      // 两级缓存（配了 Redis 才生效）：本机 L1 + Redis L2
      // "Hybrid": {
      //   // L1 条目上限，满时淘汰最久未访问的
      //   "LocalCapacity": 10000,
      //   // L1 存活上限（秒）：收不到变更通知时，别的实例的写入最迟这么久后可见
      //   "LocalTimeToLiveSeconds": 30
      // }
    },

    // ------------------------------------------------------------------------------------------
    // 消息：不配 RabbitMQ 时用进程内消息（单机）；配了绑定 queue 或 RabbitMQ:Configuration 即换成 RabbitMQ
    // ------------------------------------------------------------------------------------------
    "Messaging": {
      // 消息代理把一条消息投递给处理器的最多次数（含首次），超过进入死信
      "MaxAttempts": 3,
      // 死信主题后缀，不能为空白
      "DeadLetterSuffix": ".dlq",
      // 本实例在消息代理上的标识：1–64 个字母、数字或 ._-，字母或数字开头
      // 不写时每次启动随机生成（推荐）；写了就必须每个同时在线的实例各不相同（多副本可设成 Pod 名）
      // "InstanceId": "basicapp-0",
      // 进程内消息（没配 RabbitMQ 时生效）
      "InMemory": {
        // 每个主题（含其死信列表）的条目上限
        "MaxQueuedMessages": 10000
      },
      // 事务发件箱：要发布的消息（如领域事件）先随业务事务落表，再由后台投递到消息代理
      "Outbox": {
        // 轮询间隔（秒）
        "PollIntervalSeconds": 1,
        // 每轮最多投递条数（1–1000），也是每轮最多清理的已投递行数
        "BatchSize": 100,
        // 发件箱投递到消息代理的最多尝试次数（含首次），用尽后进死信；
        // 与上面的 XiHan:Messaging:MaxAttempts（代理投递给处理器）是两层
        "MaxAttempts": 10,
        // 第一次失败后的重试间隔（秒），之后每次翻倍
        "RetryDelaySeconds": 5,
        // 重试间隔的上限（秒）
        "MaxRetryDelaySeconds": 300,
        // 投递成功的行保留多久（秒）；0 为投递成功即删除，死信行不自动删
        "DispatchedRetentionSeconds": 86400
      }
      // RabbitMQ（配了连接才生效）
      // "RabbitMQ": {
      //   // AMQP URI（amqp:// 或 amqps://）；绑定 queue 的值优先，没有绑定或其值为空时读本键
      //   "Configuration": "amqp://<用户>:<密码>@<主机>:5672",
      //   // 队列名与路由键的前缀：订阅方声明持久队列 <前缀><主题>
      //   "QueuePrefix": "xihan.",
      //   // 发布用的持久 direct 交换机；不能为空、不能以 amq. 开头
      //   "Exchange": "xihan",
      //   // 每个消费者的预取数（1–65535）
      //   "PrefetchCount": 16,
      //   // 健康项 messaging.rabbitmq.connection 的重探间隔与单次探测超时（秒）
      //   "HealthProbeIntervalSeconds": 15
      // }
    },

    // ------------------------------------------------------------------------------------------
    // 对象存储
    // ------------------------------------------------------------------------------------------
    // BasicApp 的存储（本地目录、S3 兼容）在后台「存储配置」页面维护，本地根目录见 BasicApp:Files:LocalRootPath
    // 框架的 XiHan:ObjectStorage:S3 节在 BasicApp 里不读取，不用写
    "ObjectStorage": {
      // 各存储实例健康项 objectstorage.store.<名> 的探测间隔与单次探测超时（秒）
      "StoreHealthProbeIntervalSeconds": 15,
      // 本地存储的签名下载地址（宿主 /blobs 端点）；S3 兼容存储由存储自己签名，不用它
      "SignedUrls": {
        // HMAC-SHA256 密钥，UTF-8 至少 32 字节，多实例必须一致；缺失或太短启动即失败
        // 本文件留空，部署时用环境变量 XiHan__ObjectStorage__SignedUrls__Secret 提供
        "Secret": "",
        // 地址前缀：以 / 开头的路径或不带查询串的绝对 http(s) 地址
        "BaseUrl": "/blobs"
      }
      // 框架缺省的文件系统存储：BasicApp 的业务不用它，只是启动时会建出这个目录
      // "FileSystem": {
      //   // 根目录；不写即程序目录下的 blobs，相对路径按当前目录解析
      //   "RootPath": "blobs",
      //   // 全部对象的总字节上限，缺省 1 GiB
      //   "MaxTotalBytes": 1073741824,
      //   // 单个对象的字节上限，缺省 256 MiB
      //   "MaxBlobBytes": 268435456,
      //   // 未完成的分片上传保留多久（小时），启动扫描时清掉更早发起的
      //   "MultipartExpiryHours": 168
      // },
      // 在配置里另行定义的命名存储实例：只有被显式按名取用时才会建出，BasicApp 的业务不按名取用这里的实例
      // 名字合 ^[a-z0-9][a-z0-9-]{0,63}$，不要用 local 与 storage-* 这两类名字（Files 模块占用）
      // Provider 为 filesystem（RootPath 必填）或 s3（ServiceUrl、Region、AccessKey、SecretKey、ForcePathStyle、EnsureBuckets、HealthBucket、ConditionalWrites）
      // "Stores": {
      //   "archive": { "Provider": "filesystem", "RootPath": "/data/archive" }
      // }
    },

    // ------------------------------------------------------------------------------------------
    // 安全
    // ------------------------------------------------------------------------------------------
    "Security": {
      // 为 true 时匿名调用一律拒绝；BasicApp 由各操作的权限与策略决定，保持 false
      "RequireAuthentication": false,
      // 令牌里承载角色的声明类型
      "RoleClaim": "role",
      // JWT（HS256）：Identity 签发与框架校验共用，Hub 的 JwtBearer 也用它
      "Jwt": {
        // 对称密钥，UTF-8 至少 32 字节，缺失或太短启动即失败；多实例必须一致
        // 本文件留空，部署时用环境变量 XiHan__Security__Jwt__Secret 提供
        "Secret": "",
        // 签发者与受众：写了就按它校验，整项不写才不校验；写成空串不等于不写
        "Issuer": "xihan.basicapp",
        "Audience": "xihan.basicapp",
        // 校验有效期时允许的时钟偏移（秒）
        "ClockSkewSeconds": 60,
        // 作为主体 ID 的声明类型
        "NameClaim": "sub"
      },
      // 数据库授权：授予缓存
      "Database": {
        // 授予缓存条目上限（每个主体与租户组合一条），满时整体清空
        "CacheSize": 10000,
        // 授予缓存条目的存活时间（秒）；0 为不过期
        "CacheTimeToLiveSeconds": 30
      },
      // IP 归属地离线库（ip2region xdb，随发布目录的 IpDatabases/ 分发），相对路径按程序目录
      // 文件缺失不影响启动：首次查询时记一条警告，之后该类地址都没有归属地；路径写成空白启动即失败
      "Ip2Region": {
        "V4Database": "IpDatabases/ip2region_v4.xdb",
        "V6Database": "IpDatabases/ip2region_v6.xdb"
      },
      // 出站地址策略：向用户填的地址（工作流 Http 活动、机器人 Webhook、AI 提供商、第三方登录、
      // S3 兼容存储、CloudEvents 投递、Telegram）发请求时能连哪些 IP
      // 缺省只能连公网，回环、私网、链路本地与云元数据地址都拒绝；按建立连接时解析出的 IP 判，重定向也一样
      // 自建 MinIO、内网 Webhook、流程调内网服务、本机模型端点都要在这里放行
      "Outbound": {
        // 放行回环地址（127.0.0.0/8、::1）；本地开发用，生产环境不要打开
        "AllowLoopback": false,
        // 放行私网地址（10/8、172.16/12、192.168/16、fc00::/7）；不含链路本地与云元数据地址
        "AllowPrivateNetwork": false
        // 放行的网段（CIDR，主机位为 0）；优先于全部拒绝规则
        // "AllowedNetworks": ["10.1.0.0/16"],
        // 放行的主机名（整名相等、不区分大小写、不带协议和端口）
        // "AllowedHosts": ["minio"]
      }
    },

    // ------------------------------------------------------------------------------------------
    // 多租户：租户只从令牌声明解析，不支持查询串与 X-Tenant-Id 头
    // ------------------------------------------------------------------------------------------
    "MultiTenancy": {
      // 调用必须带租户；平台主体没有租户声明，BasicApp 必须为 false
      "RequireTenant": false,
      // 解析出的租户必须在租户目录里存在且启用；关闭后只校验格式
      "ValidateAgainstStore": true,
      // 令牌里承载租户 ID 的声明类型
      "TenantClaim": "tenant",
      // 租户分库解析的缓存容量（租户数），满时整体清空
      "ShardCacheSize": 10000,
      // 没解析到租户时用的默认租户 ID；BasicApp 不用：平台调用本来就没有租户，配了会把平台调用落到这个租户上
      // "DefaultTenant": "<租户 ID>",
      // 租户目录（数据库）的缓存
      "Database": {
        // 缓存容量（租户数，不存在的租户也占一条），满时整体清空
        "CacheSize": 10000,
        // 缓存条目的存活时间（秒）；0 为不过期
        "CacheTimeToLiveSeconds": 30,
        // 列出租户时返回的上限，超出部分不返回并记警告
        "MaxListedTenants": 10000
      }
    },

    // ------------------------------------------------------------------------------------------
    // 本地化：请求按 Accept-Language 在启用的区域里协商
    // ------------------------------------------------------------------------------------------
    "Localization": {
      // 启用的区域，逗号分隔、按优先级排列，至少一个；是一个字符串，写成数组会被当成没写
      "Locales": "en-US,zh-CN,zh-TW,ja-JP,ko-KR,de-DE,es-ES,fr-FR,pt-BR,ru-RU",
      // 协商不到时使用的默认区域，必须在 Locales 里；改 Locales 去掉 en-US 时要一起改
      "DefaultLocale": "en-US",
      // 运营覆盖的译文（平台库表 message_translation），同键同区域时优先于程序集内嵌的文案
      "Database": {
        // 快照刷新间隔（秒）；0 只在启动时加载
        "RefreshIntervalSeconds": 300,
        // 快照最多加载的译文条数，超出部分不加载并记警告
        "MaxTranslations": 100000
      }
    },

    // ------------------------------------------------------------------------------------------
    // 框架的操作审计（与 BasicApp:Auditing 的应用日志分开）
    // ------------------------------------------------------------------------------------------
    "Auditing": {
      // 没有显式动作时记哪些操作：Protected（声明了权限的）、All、None
      // BasicApp 由 Auditing 包按「是否标了审计」显式声明，框架自己不挑，保持 None
      "Selection": "None",
      // 成功的调用也记；为 false 时只记失败
      "IncludeSuccesses": true,
      // 按操作排除：操作 ID，或以 * 结尾的前缀；必须写成非空列表
      // "Exclude": ["profile.*"],
      // 审计事件落库的队列
      "Database": {
        // 等待落库的事件数上限，满了丢弃新事件并计数
        "QueueCapacity": 10000,
        // 一批落库的事件数上限，攒够即刷写
        "BatchSize": 100,
        // 刷写间隔（秒）
        "FlushIntervalSeconds": 1,
        // 是否把每条事件写进日志（Information 级）
        "LogEvents": true
      }
    },

    // ------------------------------------------------------------------------------------------
    // 后台作业调度（数据库实现，多节点选主）
    // ------------------------------------------------------------------------------------------
    "Scheduling": {
      // 引擎轮询周期（秒）
      "PollIntervalSeconds": 1,
      // 本节点同时运行的作业上限
      "MaxConcurrentRuns": 32,
      // 一个轮询周期最多抢占的触发器数
      "AcquireBatchSize": 16,
      // 到期时刻落后当前时刻超过它（秒）才算 misfire
      "MisfireThresholdSeconds": 60,
      // 领导租约的资源名
      "LeaseResource": "scheduling.jobs",
      // 领导租约的存活时间（秒）
      "LeaseTimeToLiveSeconds": 30,
      // 节点心跳超过它（秒）即视为失联
      "NodeTimeoutSeconds": 90,
      // 领导者维护（失联恢复、历史清理）的周期（秒）
      "HousekeepingIntervalSeconds": 60,
      // 运行历史保留期（天，可带小数）；0 为不删
      "HistoryRetentionDays": 7,
      // 本节点 ID；不写即 机器名:进程 ID:随机串
      // "NodeId": "node-1",
      "Database": {
        // 健康项 scheduling.database.leader 的重探间隔与单次探测超时（秒）
        "HealthProbeIntervalSeconds": 15
      }
    },

    // ------------------------------------------------------------------------------------------
    // 工作流引擎（数据库实现）：定义、实例、节点实例与书签按分区落表，另有一张租约表
    // ------------------------------------------------------------------------------------------
    "Workflow": {
      // 一个波次最多执行的节点数，超过即实例故障（防死循环）
      "MaxNodeExecutionsPerBurst": 1000,
      // 子流程最大深度
      "MaxSubWorkflowDepth": 16,
      // 等实例锁的上限（秒），超过即 WORKFLOW_TIMEOUT_001
      "LockTimeoutSeconds": 10,
      // 到期书签因实例不在运行中而不能恢复时，到期时间后推的秒数
      "NotResumableBackoffSeconds": 300,
      // 表达式缓存上限
      "ExpressionCacheSize": 10000,
      // 已结束实例的保留期（天，可带小数）；0 为不自动清理
      "RetentionDays": 0,
      // 按保留期清理的周期（秒）
      "HousekeepingIntervalSeconds": 3600,
      // Http 活动的默认超时（秒）
      "HttpTimeoutSeconds": 30,
      "Database": {
        // 到期书签（延时、超时、重试）的轮询周期（秒）
        "PollIntervalSeconds": 1,
        // 每次轮询最多恢复的书签数
        "BatchSize": 100,
        // 实例锁与轮询领导权的租约时长（秒），每三分之一续约一次
        "LockLeaseSeconds": 60,
        // 健康项 workflow.database.poller 的重探间隔与单次探测超时（秒）
        "HealthProbeIntervalSeconds": 15
        // 本节点写进租约行的标识；不写即 机器名:进程 ID:随机串
        // "HolderId": "workflow-node-1",
        // 租约表所在的命名连接；不写即平台库。SQLite 必须配到另一个库文件（在 XiHan:Persistence:SqlSugar:Connections 声明），
        // 否则业务事务与租约互相等到 WORKFLOW_TIMEOUT_001；PostgreSQL 不用配
        // "LockConnection": "leases"
      }
    },

    // ------------------------------------------------------------------------------------------
    // AI：框架的工具目录常装，这一节总会被读取校验（写错时关了 AI 模块也会启动失败）；
    // 开了 AI 模块后，聊天、知识库与提示增强才真正用到它
    // 模型提供商在后台「AI 提供商」页面维护：框架的 Providers、DefaultProvider、DefaultEmbeddingProvider 在 BasicApp 里不生效，不要写
    // ------------------------------------------------------------------------------------------
    "AI": {
      // 知识库
      "Knowledge": {
        // 嵌入用的提供商（后台「AI 提供商」里的名称）；不写即标为缺省的那一个
        // "EmbeddingProvider": "<提供商名称>",
        // 检索增强用的提示词模板名，只能引用下面 Prompts 里的模板；不写即内置模板
        // 模板只能用 {context}、{question} 两个占位符，找不到或用了别的占位符启动即失败
        // "PromptName": "rag",
        // 嵌入维度，要与嵌入模型一致
        "Dimensions": 1536,
        // 切块大小（字符）
        "ChunkSize": 1000,
        // 相邻块的重叠（字符）
        "ChunkOverlap": 100,
        // 默认检索条数
        "Top": 5,
        // 默认集合名，须合 ^[a-z0-9][a-z0-9._-]{0,63}$
        "Collection": "knowledge"
      },
      // 内置护栏
      "Guardrails": {
        // 是否登记内置关键词护栏
        "Enabled": false,
        // 是否启用内置的中英文提示注入模式
        "UseBuiltInInjectionHeuristics": true
        // 被禁止的关键词（不区分大小写的子串）
        // "BlockedKeywords": ["<关键词>"],
        // 提示注入的正则模式（不区分大小写）
        // "InjectionPatterns": ["ignore\\s+previous"]
      },
      // 操作暴露成 AI 工具时的名字覆盖：键为操作 ID，值为工具名（字母、数字、_、-，1–64 个字符）
      // "Tools": {
      //   "users.list": "list_users"
      // },
      // 配置里声明的提示词模板（给 Knowledge:PromptName 用）；后台「提示词」页面的模板不在这里
      // 值可以直接写模板文本，也可以写成 { "Template": ..., "Description": ... }
      // "Prompts": {
      //   "rag": { "Template": "根据资料回答问题。\n资料：{context}\n问题：{question}", "Description": "知识库问答" }
      // },
      // 向量库（配了 BasicApp:AI:Qdrant:Host 才生效）
      "VectorData": {
        // 健康项 ai.vectordata.store 的重探间隔与单次探测超时（秒）
        "HealthProbeIntervalSeconds": 15
      }
    },

    // ------------------------------------------------------------------------------------------
    // 可观测性：OpenTelemetry 导出与主机运行信息
    // ------------------------------------------------------------------------------------------
    "Observability": {
      // 主机运行信息（CPU、内存、网卡）的采样
      "Host": {
        // 采样间隔（秒，最大 3600）；CPU 使用率与网卡速率是相邻两次采样之差
        "SampleIntervalSeconds": 5
      },
      "OpenTelemetry": {
        // 资源属性 service.name / service.version；不写即入口程序集的名称（XiHan.BasicApp.Host）与版本
        // "ServiceName": "xihan-basicapp",
        // "ServiceVersion": "6.0.0",
        // 是否导出追踪、指标与日志
        "Tracing": true,
        "Metrics": true,
        "Logging": true,
        // 是否同时写到控制台导出器（开发排查用）
        "Console": false,
        // 根 Span 的采样比例（0–1）；有上游决定的沿用上游
        "SamplingRatio": 1
        // 默认之外额外订阅的 Activity 源与 Meter：逗号分隔的字符串，写成数组会被忽略
        // 默认已订阅 XiHan.Framework、Microsoft.AspNetCore、System.Net.Http 等
        // "Sources": "MyCompany.Orders",
        // "Meters": "MyCompany.Orders",
        // OTLP 导出
        // "Otlp": {
        //   // 是否启用；不写即自动：配了端点（Endpoint 或标准环境变量 OTEL_EXPORTER_OTLP_ENDPOINT）就启用
        //   "Enabled": true,
        //   // OTLP 端点（绝对 URI）
        //   "Endpoint": "http://localhost:4317",
        //   // 协议 Grpc（缺省）或 HttpProtobuf；须与 Endpoint 同时配置
        //   "Protocol": "Grpc"
        // }
      }
    },

    // ------------------------------------------------------------------------------------------
    // 协议适配器：同一个操作按 Expose 发布到 HTTP、gRPC、MCP 与 CloudEvents
    // ------------------------------------------------------------------------------------------
    "Protocols": {
      "Http": {
        // 所有操作路由的前缀，以 / 开头、不以 / 结尾；前端与开放接口都按它调用，不要改
        "RoutePrefix": "/api"
        // 按操作 ID 覆盖约定推导出的路由（METHOD /模板），方法限 GET/POST/PUT/PATCH/DELETE；前端按约定路由调用，改了要同步
        // "Routes": {
        //   "<操作 ID>": "POST /<路径>"
        // }
      },
      "Grpc": {
        // protobuf 包名，也是服务路径前缀（/xihan.basicapp.Users/Get）
        "Package": "xihan.basicapp"
        // 按操作 ID 覆盖 gRPC 方法名（Service/Method）
        // "Methods": {
        //   "users.get": "Users/Get"
        // }
      },
      "Mcp": {
        // initialize 答复里的服务端名
        "ServerName": "XiHan.BasicApp"
        // initialize 答复里的服务端版本；不写即框架版本
        // "ServerVersion": "6.0.0",
        // initialize 答复里给客户端模型的使用说明；不写即不给
        // "Instructions": "<使用说明>",
        // 按操作 ID 覆盖 MCP 工具名（字母、数字、_、-，1–64 个字符）
        // "Tools": {
        //   "users.list": "users_list"
        // }
      },
      // CloudEvents：入站端点由 BasicApp:CloudEvents:Enabled 控制
      "CloudEvents": {
        // 入站处理方式：Dispatch 在请求内派发给主题的处理器、处理器的结果即响应；Publish 发布到消息代理后立即 202
        "Inbound": "Dispatch",
        // 出站 Webhook 的内容模式：Binary 或 Structured
        "Outbound": "Binary",
        // 出站 Webhook 是否在 HTTP 头里写追踪上下文（traceparent、tracestate、baggage）
        "PropagateTraceContext": false
        // 入站事件类型到主题的映射；没写时事件类型本身须是合法主题
        // "Topics": {
        //   "com.example.order.created": "orders.created"
        // },
        // 主题对应的出站 Webhook 地址（绝对 http(s) URL）
        // "Webhooks": {
        //   "orders.created": "https://hooks.example.com/orders"
        // }
      }
    }
  },

  // ============================================================================================
  // BasicApp：应用节，由各能力包读取
  // 除特别注明外，写了就会校验：类型或取值不合法时启动即失败（不会悄悄退回缺省值）
  // ============================================================================================
  "BasicApp": {
    // ------------------------------------------------------------------------------------------
    // 平台库的从库（读写分离）与 SQL 诊断日志
    // 主库连接在 XiHan:Bindings:db；从库只给平台库，独立库租户读写都走它自己的主库
    // ------------------------------------------------------------------------------------------
    "Database": {
      // 平台库的从库列表；不写即单库。配了之后只读工作单元的读走从库、会写的工作单元走主库
      // 每项 ConnectionString 必填；HitRate 是读权重（正整数），不写取 XiHan:Persistence:SqlSugar:Replicas:DefaultHitRate
      // 从库的健康探测、摘除与恢复在 XiHan:Persistence:SqlSugar:Replicas
      "Replicas": [
        // { "ConnectionString": "Host=<从库主机>;Port=5432;Database=<库名>;Username=<用户>;Password=<密码>", "HitRate": 10 }
      ],
      // 记录每条 SQL（只记语句，不记参数值）；日志量大，只在排查时打开
      "LogSql": false,
      // 记录执行出错的 SQL
      "LogSqlErrors": true,
      // 记录慢 SQL
      "LogSlowSql": true,
      // 慢 SQL 的阈值（毫秒，正整数）；只影响记录，不影响语句执行
      "SlowSqlThresholdMilliseconds": 1000
    },

    // ------------------------------------------------------------------------------------------
    // 表结构升级：启动时按 Schema/<版本>/*.sql 与版本台账升级平台库与各租户库
    // ------------------------------------------------------------------------------------------
    "Schema": {
      // 启动时自动升级，失败即中断启动；关掉时由运维先执行 `XiHan.BasicApp.Host schema upgrade` 再启动
      "AutoUpgrade": true,
      // 脚本目录；不写即程序目录下的 Schema。相对路径按程序目录（不是当前目录）解析
      // "Directory": "Schema",
      // 升级锁的失效时间（分钟，1–1440）：持锁节点中途退出时，过了这么久别的节点才能接手
      "LockExpiryMinutes": 30,
      // 等别的节点升级完的最长时间（分钟，1–1440）；等不到即升级失败、中断启动
      "LockWaitMinutes": 10
    },

    // ------------------------------------------------------------------------------------------
    // 种子数据：执行 seed 命令时写入（dotnet run ... -- seed），不随启动自动执行
    // ------------------------------------------------------------------------------------------
    "Seed": {
      // 是否写演示数据：演示租户 demo 及其组织、角色与访问策略，平台演示字典，平台与 demo 的草稿通知
      "EnableDemoData": false,
      // 超级管理员 superadmin 的初始密码，只在账号不存在、首次写入时使用
      // 首次执行种子时没配即失败（IDENTITY_VALIDATION_026），不会落一个公开的缺省密码
      // 不要提交真实密码：部署时用环境变量 BasicApp__Seed__SuperAdminPassword 提供
      "SuperAdminPassword": ""
    },

    // ------------------------------------------------------------------------------------------
    // 可选模块开关：<名>:Enabled 不写即开启，写了必须是 true / false
    // 关掉的模块宿主不装配：它的页面与权限码不下发，前端随菜单不再出现，操作返回 404
    // ------------------------------------------------------------------------------------------
    "Modules": {
      // 工作台；关掉后登录落到第一个有权限的页面，前端把 VITE_HOME_PATH 留空
      "Workbench": { "Enabled": true },
      // 打印模板；关掉后其他包登记的打印数据源没有消费方
      "Printing": { "Enabled": true },
      // 在线聊天与聊天审计；关掉后聊天 Hub 与附件上传端点不映射
      "Chat": { "Enabled": true },
      // 流程定义、流程实例与审批中心；引擎与它的表照旧（宿主恒装数据库工作流），关掉只关 BasicApp 的 Workflow 包
      "Workflow": { "Enabled": true },
      // 代码生成（只在平台一侧）；关掉后表照样建，已登记的外部数据源连接不再建立
      "CodeGeneration": { "Enabled": true },
      // AI 提供商、提示词、知识库与助手；关掉后聊天照常、助手入口隐藏
      "AI": { "Enabled": true }
    },

    // ------------------------------------------------------------------------------------------
    // 接口文档：/openapi.json、/openapi/<组>.json 与 /scalar（不鉴权）
    // ------------------------------------------------------------------------------------------
    "ApiDocs": {
      // 不写时 Development 为 true、其余环境为 false；生产环境确需开放时再显式写 true
      // "Enabled": false
    },

    // ------------------------------------------------------------------------------------------
    // 反向代理转发头：在管道最前面还原 X-Forwarded-For / -Proto / -Host
    // 访问日志、会话与登录地点、登录节流与自动封禁、访问策略的地址条件据此拿到客户端地址
    // 只信本机回环与下面列出的代理
    // ------------------------------------------------------------------------------------------
    "ForwardedHeaders": {
      // 受信代理的单个地址，如 "10.0.0.5"
      "KnownProxies": [],
      // 受信代理的网段（CIDR，主机位必须为 0），如 "10.0.0.0/8"
      "KnownNetworks": [],
      // 从右往左认几层转发（正整数）
      "ForwardLimit": 1
    },

    // ------------------------------------------------------------------------------------------
    // 跨域：前端与后端不同源部署时打开
    // AllowedOrigins 与 AllowAnyOrigin 都没写即不启用跨域，只能同源访问
    // ------------------------------------------------------------------------------------------
    "Cors": {
      // 允许的来源：协议 + 主机 + 可选端口，不带路径与结尾斜杠，如 "https://admin.example.com"
      "AllowedOrigins": [],
      // 放开全部来源；不能与 AllowedOrigins 同时写，也不能与 AllowCredentials=true 同时用
      "AllowAnyOrigin": false,
      // 是否允许任意方法；为 false 时必须写 AllowedMethods
      "AllowAnyMethod": true,
      // 允许的方法，如 ["GET", "POST", "PUT", "DELETE"]；AllowAnyMethod 为 false 时才用
      "AllowedMethods": [],
      // 是否允许任意请求头；为 false 时必须写 AllowedHeaders
      "AllowAnyHeader": true,
      // 允许的请求头；AllowAnyHeader 为 false 时才用
      "AllowedHeaders": [],
      // 是否允许携带凭据（Cookie、Authorization 头）
      "AllowCredentials": true,
      // 暴露给前端脚本读取的响应头，如 ["Content-Disposition"]
      "ExposedHeaders": [],
      // 预检结果的缓存秒数；0 为不设置
      "PreflightMaxAgeSeconds": 0
    },

    // ------------------------------------------------------------------------------------------
    // CloudEvents 入站端点 POST /events，供内部服务投递事件
    // 调用方须持有权限码 runtime.cloud-events.deliver（只授给平台的服务账号或服务角色），没有即 403
    // 只开放给内网，不要经反向代理暴露到公网；主题映射、入站方式与出站 Webhook 见 XiHan:Protocols:CloudEvents
    // ------------------------------------------------------------------------------------------
    "CloudEvents": {
      "Enabled": false
    },

    // ------------------------------------------------------------------------------------------
    // 数据保护（ASP.NET Core Data Protection）：加密参数、存储密钥、租户连接串、认证器密钥、
    // 通道密钥与机器人 Webhook 地址都用它加密
    // ------------------------------------------------------------------------------------------
    "DataProtection": {
      // 密钥环目录；不写即 ASP.NET Core 的缺省位置（单机开发够用）
      // 多实例部署必须指向各实例都能读写的同一个目录，否则各实例互相解不开密文
      // "KeysDirectory": "/var/lib/xihan-basicapp/keys"
    },

    // ------------------------------------------------------------------------------------------
    // 身份认证：令牌、登录失败锁定、密码策略、图形验证码、登录节流、双因素、验证码与自助注册
    // 数字须为正数（PasswordHistoryDepth 可为 0）；登录页开放哪些方式在系统参数 identity.login-methods
    // ------------------------------------------------------------------------------------------
    "Auth": {
      // 访问令牌有效期（分钟）
      "AccessTokenMinutes": 120,
      // 刷新令牌（会话）有效期（天）
      "RefreshTokenDays": 7,
      // 连续登录失败多少次后锁定账号
      "MaxFailedAccessAttempts": 5,
      // 锁定时长（分钟）
      "LockoutMinutes": 15,
      // 密码最短长度
      "PasswordMinLength": 8,
      // 不得与最近多少个历史密码相同；0 不检查，最多 1000
      "PasswordHistoryDepth": 3,
      // 会话门禁的缓存秒数；吊销会话最迟在这么久后对其他实例生效
      "SessionCacheSeconds": 30,
      // 密码登录是否要求图形验证码
      "CaptchaEnabled": true,
      // 图形验证码有效期（秒）
      "CaptchaSeconds": 300,
      // 登录节流的固定窗口（秒）
      "LoginThrottleWindowSeconds": 60,
      // 同一账号在同一地址上每个窗口允许的失败次数
      "LoginThrottleAccountLimit": 5,
      // 同一地址每个窗口允许的失败次数（跨账号累计）
      "LoginThrottleIpLimit": 30,
      // 两步验证票据有效期（分钟），从签发起算、不顺延
      "TwoFactorTicketMinutes": 10,
      // 一张两步验证票据允许输错验证码的次数，用完即作废、须重新登录
      "TwoFactorTicketMaxFailures": 5,
      // 认证器（TOTP）App 里显示的签发方
      "TotpIssuer": "XiHan BasicApp",
      // 是否开放自助注册（auth.register，注册的是平台账号）；确认要开放再打开
      "SelfRegistrationEnabled": false,
      // 邮件 / 短信验证码的有效期（分钟）
      "VerificationCodeMinutes": 10,
      // 同一用途、同一目标两次发码的最短间隔（秒）
      "VerificationCodeIntervalSeconds": 60,
      // 一个邮箱 / 手机号每天（UTC）最多收几次验证码，不分用途
      "VerificationCodeDailyPerTarget": 10,
      // 一个客户端地址每天（UTC）最多发几次验证码，不分用途
      "VerificationCodeDailyPerAddress": 50,
      // 一个验证码允许输错的次数；用完即作废并锁定
      "VerificationCodeMaxFailures": 5,
      // 输错用完后同一用途、同一主体不能再发码与校验的时长（分钟）
      "VerificationCodeLockoutMinutes": 10,

      // ----------------------------------------------------------------------------------------
      // 第三方登录：不分租户、不存库；启用且填了 ClientId 的提供方才出现在登录页
      // 第三方账号要先在个人中心绑定本地账号才能登录（不自动建号）
      // 在第三方后台登记的回调地址：<CallbackBaseUrl>/api/oauth/<Name>/callback
      // ----------------------------------------------------------------------------------------
      "OAuth": {
        // 总开关；没有可用的提供方时等于关
        "Enabled": true,
        // 回调后带着一次性票据跳去的前端页面；前后端同源时用缺省即可
        "FrontendCallbackUrl": "/#/auth/oauth-callback",
        // 回调地址的来源（协议 + 主机 + 端口），如 "https://admin.example.com"
        // 不写即取请求的来源；经反向代理时要么写它，要么保证转发头配置正确
        // "CallbackBaseUrl": "https://<后端对外地址>",
        // 提供方列表（按顺序显示，同名只取第一个）
        // Name：路由与登录页用的名称（小写）；Provider：类型，不写即按 Name 判定
        //   支持 github、gitee、google、qq、wechat（别名 weixin）、wecom（别名 workweixin）、lark（别名 feishu）、dingtalk
        // ClientId / ClientSecret：应用凭据（微信为 appid / secret，企业微信为 corpid / 应用的 corpsecret）；不要提交真实密钥
        // Enabled：缺省 true；DisplayName：登录页上的显示名，缺省同 Name
        // Mode：QrCode（扫码，缺省）或 Account（账号授权：微信公众号网页授权、企业微信网页授权、飞书、钉钉账号登录）
        // AgentId：企业微信的应用 AgentId；CorpId：钉钉限定组织；LoadMemberProfile：企业微信再取成员资料（姓名通常只在这里有）
        // Scopes：额外的授权范围（微信 / 企业微信整体替换缺省，其余追加）；AuthorizationEndpoint：授权页地址覆盖
        "Providers": [
          // { "Name": "github", "ClientId": "<客户端 ID>", "ClientSecret": "<客户端密钥>" },
          // { "Name": "gitee", "ClientId": "<客户端 ID>", "ClientSecret": "<客户端密钥>" },
          // { "Name": "google", "ClientId": "<客户端 ID>", "ClientSecret": "<客户端密钥>" },
          // { "Name": "qq", "ClientId": "<APP ID>", "ClientSecret": "<APP Key>" },
          // { "Name": "wechat", "ClientId": "<appid>", "ClientSecret": "<secret>", "Mode": "QrCode" },
          // { "Name": "wecom", "ClientId": "<corpid>", "ClientSecret": "<应用 secret>", "AgentId": "<AgentId>", "Mode": "QrCode", "LoadMemberProfile": true },
          // { "Name": "lark", "ClientId": "<App ID>", "ClientSecret": "<App Secret>", "DisplayName": "飞书" },
          // { "Name": "dingtalk", "ClientId": "<AppKey>", "ClientSecret": "<AppSecret>", "CorpId": "<corpId>" }
        ]
      }
    },

    // ------------------------------------------------------------------------------------------
    // 授权：权限条件与访问策略
    // ------------------------------------------------------------------------------------------
    "Access": {
      // 权限条件的生效模式：Enforce（判定）、LogOnly（只记日志不拦截）、Disabled（不判定）
      "PermissionConditionMode": "Enforce",
      // 访问策略总开关；策略把自己锁在外面时由运维在这里关掉
      "AccessPolicyEnabled": true,
      // 条件里时刻、小时、星期与日期所按的时区（系统时区 ID，IANA 或 Windows 写法均可）
      "ConditionTimeZone": "Asia/Shanghai"
    },

    // ------------------------------------------------------------------------------------------
    // 审计日志（BasicApp 自己的访问、异常、登录与变更日志，按月分表）
    // 与框架的 XiHan:Auditing（操作审计中间件）分开
    // ------------------------------------------------------------------------------------------
    "Auditing": {
      // 等待落库的日志条数上限；满了新到的丢弃并计数，不阻塞调用
      "QueueCapacity": 10000,
      // 一批落库的条数上限，攒够即刷写
      "BatchSize": 200,
      // 刷写间隔（秒，正数，可带小数）；不足一批也按此周期刷写
      "FlushIntervalSeconds": 1,
      "AccessLog": {
        // 是否记访问日志
        "Enabled": true,
        // 不记访问日志的操作 ID，如 ["auth.me"]；异常、登录与变更日志不受影响
        "Exclude": []
      },
      // 系统参数 auditing.retention-days 没建时的保留天数
      "DefaultRetentionDays": 180,
      // 保留清理作业的计划（cron，按 UTC），缺省每天 03:00
      "RetentionCron": "0 3 * * *"
    },

    // ------------------------------------------------------------------------------------------
    // 文件：上传、分片与签名下载地址（存储本身在后台「存储配置」里维护）
    // 写错不报错：不合法或不是正数的值按缺省值处理
    // ------------------------------------------------------------------------------------------
    "Files": {
      // 本地存储的根目录，相对路径按内容根目录解析；各本地存储配置的桶是它下面的子目录
      "LocalRootPath": "App_Data/files",
      // 单个文件的大小上限（字节），缺省 100 MiB
      "MaxUploadBytes": 104857600,
      // 分片上传每片的大小（字节），缺省 8 MiB；不小于存储要求的最小分片 5 MiB
      "UploadPartBytes": 8388608,
      // 分片上传从发起到完成的时限（d.hh:mm:ss）
      "UploadLifetime": "1.00:00:00",
      // 签名下载地址的缺省有效期（hh:mm:ss）
      "LinkLifetime": "00:30:00",
      // 签名下载地址的最长有效期（d.hh:mm:ss）
      "MaxLinkLifetime": "7.00:00:00"
    },

    // ------------------------------------------------------------------------------------------
    // 通知：邮件、短信、机器人发件箱与 Telegram 交互（通道与机器人本身在后台页面配置）
    // 写错不报错：不合法的值按缺省值处理
    // ------------------------------------------------------------------------------------------
    "Notification": {
      // 邮件与短信模板变量 brand 的缺省值；不写即应用名
      // "Brand": "XiHan.BasicApp",
      // 发送循环的轮询间隔（hh:mm:ss）；有新记录时提前唤醒
      "DispatchInterval": "00:00:05",
      // 失败后重试的基础间隔（hh:mm:ss）；第 n 次失败后等 n 倍
      "RetryDelay": "00:00:30",
      // 每条记录最多尝试的次数
      "MaxAttempts": 3,
      // 发送中超过这么久还没结果即视为进程中断、改回排队中（hh:mm:ss）
      "StuckAfter": "00:10:00",

      // Telegram 机器人的进程内选项；机器人、Webhook 与代理在系统参数 notification.telegram 里配
      "Telegram": {
        // 全部机器人共用的同时处理上限
        "MaxDispatchConcurrency": 16,
        // 消息去重标记的保留时长（hh:mm:ss）
        "DedupLifetime": "00:30:00",
        // 长轮询每次等待的秒数（不配 Webhook 时用长轮询）
        "PollingTimeoutSeconds": 50,
        // 回复文案；写成空串即不发该条回复。{botUsername}、{chatId}、{userId} 会被替换
        "Texts": {
          "StartReply": "你好，欢迎使用 {botUsername}！发送 /help 查看可用命令。",
          "HelpTitle": "可用命令：",
          "MyIdReply": "ChatId：{chatId}\nUserId：{userId}",
          "CommandDisabledReply": "该命令未开启。",
          "CommandAdminOnlyReply": "该命令仅管理员可用。",
          "CallbackAdminOnlyReply": "该操作仅管理员可用。",
          "FallbackReply": "暂不支持处理该消息，发送 /help 查看可用命令。",
          "InternalErrorReply": "处理消息时出错，请稍后再试。",
          "SendFailureAdminNotifyTitle": "消息发送失败告警",
          "StartDescription": "开始使用机器人",
          "HelpDescription": "查看帮助",
          "MyIdDescription": "查看我的 Telegram Id"
        },
        // 出站调用 Bot API 的重试
        "Retry": {
          // 失败后最多再试的次数（即最多 MaxRetries + 1 次）
          "MaxRetries": 3,
          // 退避的基础毫秒数：第 n 次等 min(MaxDelayMs, BaseDelayMs × 2^(n-1))
          "BaseDelayMs": 500,
          // 退避上限（毫秒）
          "MaxDelayMs": 10000,
          // 429 的 retry_after 最多等多少秒，超过即按失败处理
          "MaxRetryAfterSeconds": 60,
          // 最终失败时是否私发管理员告警
          "NotifyAdminOnFinalFailure": true
        }
      }
    },

    // ------------------------------------------------------------------------------------------
    // 实时通信（SignalR）的 Hub 参数，对全部 Hub 生效；缺省即 ASP.NET Core 的缺省值
    // 时长写 hh:mm:ss（可带天数 d.hh:mm:ss）且大于零，只写 15 或 00:15 都算写错
    // ------------------------------------------------------------------------------------------
    "Realtime": {
      "SignalR": {
        // 把详细错误发给客户端；生产环境不要打开
        "EnableDetailedErrors": false,
        // 服务端发保活消息的间隔；调到 30 秒以上会让浏览器（缺省 30 秒超时）不断掉线重连
        "KeepAliveInterval": "00:00:15",
        // 多久没收到客户端的消息算断开，一般设成客户端保活间隔的两倍
        "ClientTimeoutInterval": "00:00:30",
        // 握手的超时
        "HandshakeTimeout": "00:00:15",
        // 单条入站消息的大小上限（字节）
        "MaximumReceiveMessageSize": 32768,
        // 流式调用的缓冲容量
        "StreamBufferCapacity": 10,
        // 每个客户端的最大并行调用数
        "MaximumParallelInvocationsPerClient": 1
      }
    },

    // ------------------------------------------------------------------------------------------
    // 开放平台：签名接口与 OAuth2 / OIDC 授权服务（BasicApp 作为授权方）
    // 写错不报错：数字超出范围时夹到范围内
    // ------------------------------------------------------------------------------------------
    "OpenPlatform": {
      // 签名请求的时间戳与服务端时间的最大偏差（秒，30–3600）；随机串保留它的两倍
      "TimestampToleranceSeconds": 300,
      // 开放接口请求体上限（字节，1 KiB–64 MiB），缺省 2 MiB
      "MaxRequestBodyBytes": 2097152,
      // OIDC 签发者，不带结尾斜杠；不写即请求来源加 /api/oauth2，经反向代理时要显式写
      // "Issuer": "https://admin.example.com/api/oauth2",
      // 授权同意页（前端路由），授权端点把查询串原样带过去
      "ConsentPageUrl": "/#/oauth/authorize",
      // id_token 有效期（秒，60–3600）
      "IdTokenLifetimeSeconds": 600
    },

    // ------------------------------------------------------------------------------------------
    // 代码生成
    // ------------------------------------------------------------------------------------------
    "CodeGeneration": {
      // 导入表时推断类名去掉的表名前缀，逗号分隔（是一个字符串，不是数组），取最长的匹配
      "TablePrefixes": "sys_",
      // 是否允许「生成到项目」（直接写进后端与前端源码目录）；打开了也只在 Development 生效
      "EnableGenerateToProject": false,
      // 是否开放 SQLite 数据源；SQLite 的地址是服务器上的文件路径，开放等于能读进程够得着的任意数据库文件
      "AllowSqliteDataSource": false
      // 生成到项目时后端的根目录（含 src/ 的 backend-next），相对宿主的内容根目录
      // "BackendRootPath": "../..",
      // 生成到项目时前端的根目录（含 package.json 的 frontend-next），相对宿主的内容根目录
      // "FrontendRootPath": "../../../frontend-next"
    },

    // ------------------------------------------------------------------------------------------
    // AI 知识库的向量库（Qdrant）
    // 写了 Host 才登记 Qdrant 连接器并装知识库，健康检查多一项 ai.vectordata.store；不写即知识库不可用
    // 地址、密钥写错启动不报错，连不上时健康项是 Degraded，摄入的文档以失败保存
    // 向量维度、检索条数与切块参数在 XiHan:AI:Knowledge
    // ------------------------------------------------------------------------------------------
    "AI": {
      "Qdrant": {
        // 主机名；空白即没配
        // "Host": "localhost",
        // gRPC 端口（1–65535）；6333 是 REST 端口，连接器不用
        // "Port": 6334,
        // 是否走 HTTPS（true / false）
        // "Https": false,
        // API 密钥；不要提交真实密钥
        // "ApiKey": "<API 密钥>"
      }
    }
  }
}
