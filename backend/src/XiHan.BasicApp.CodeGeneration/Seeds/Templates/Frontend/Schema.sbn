{{~ # 一列都不进表单就没有可编辑内容，页面不产弹窗，这里也不产增改按钮（与 index.vue 的裁剪同源） ~}}
{{~ has_form_field = false ~}}
{{~ has_import_date = false ~}}
{{~ has_relation_field = false ~}}
{{~ for col in Columns ~}}
{{~ if col.InForm ~}}
{{~ has_form_field = true ~}}
{{~ end ~}}
{{~ end ~}}
{{~ can_create = CanCreate && has_form_field ~}}
{{~ can_update = CanUpdate && has_form_field ~}}
{{~ # 导入逐行调新建操作，列集合即新建表单的列（引擎保证勾了导入就一定勾了新建） ~}}
{{~ can_import = CanImport && can_create ~}}
{{~ for col in Columns ~}}
{{~ if can_import && col.IsImportable && (col.ControlKind == "date" || col.ControlKind == "datetime") ~}}
{{~ has_import_date = true ~}}
{{~ end ~}}
{{~ if col.Relation ~}}
{{~ has_relation_field = true ~}}
{{~ end ~}}
{{~ end ~}}
{{~ has_filters = false ~}}
{{~ has_ranges = false ~}}
{{~ has_multiples = false ~}}
{{~ for col in Columns ~}}
{{~ if col.SearchKind == "eq" || col.SearchKind == "ge" || col.SearchKind == "le" ~}}
{{~ has_filters = true ~}}
{{~ else if col.SearchKind == "range" ~}}
{{~ has_ranges = true ~}}
{{~ else if col.SearchKind == "multiple" ~}}
{{~ has_multiples = true ~}}
{{~ end ~}}
{{~ end ~}}
/**
 * 本文件由代码生成器产出，重新生成时整体覆盖，请勿手改
 * 列定义与表单缺省值的微调写在 {{ Resource }}.schema.ts（在那里对下列 base* 做 transform）
 */
import type { ListFieldSchema, PageSchema, SchemaQueryParams, SchemaResource } from '~/components'
import type { PageQueryMapping, {{ if can_create || can_update }}RequestOf, {{ end }}ResponseOf } from '~/contracts'
{{~ if CanDelete || CanStatus ~}}
import { {{ if CanDelete }}deleteConfirmText{{ end }}{{ if CanDelete && CanStatus }}, {{ end }}{{ if CanStatus }}statusConfirmText{{ end }} } from '~/components'
{{~ end ~}}
import { {{ [ResourceCamel + " as " + ResourceCamel + "Api", "toPageRequest", "toSchemaPageResult"] | sort_names | array.join ", " }} } from '~/contracts'
{{~ if CanDelete ~}}
import { throwOnFailed } from '~/request'
{{~ end ~}}

type Translate = (key: string, params?: Record<string, unknown>) => string

/** 列表的一行，也是详情（一个资源一个响应） */
export type {{ ClassName }}Row = ResponseOf<'{{ Resource }}.list'>['items'][number]
{{~ if can_create ~}}

/** 新建请求 */
export type {{ ClassName }}CreateRequest = RequestOf<'{{ Resource }}.create'>
{{~ end ~}}
{{~ if can_update ~}}

/** 修改请求 */
export type {{ ClassName }}UpdateRequest = RequestOf<'{{ Resource }}.update'>
{{~ end ~}}
{{~ if has_form_field ~}}

/**
 * {{ DisplayName | block_comment }}表单模型
 */
export interface {{ ClassName }}FormModel {
{{~ # 字段类型取 FormTsType（渲染器按 ControlKind 算好的）：开关恒 boolean、日期与日期时间按时间戳承载、枚举取契约的字面量。 ~}}
{{~ # 除开关外一律可空：输入框、数字框、下拉、日期都能被清空，编辑态的模型得装得下空值；报文要不要空由提交时的 FormToWire 决定。 ~}}
{{~ for col in Columns ~}}
{{~ if col.InForm ~}}
{{~ if col.ControlKind == "switch" ~}}
  {{ col.Field }}: boolean
{{~ else if col.FormTsType == "enum" ~}}
  {{ col.Field }}: NonNullable<{{ ClassName }}Row['{{ col.Field }}']> | null
{{~ else ~}}
  {{ col.Field }}: {{ col.FormTsType }} | null
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
}
{{~ end ~}}

/**
 * 页面元信息
 *
 * 导出、导入、批量删除与批量启停按权限码门控：取消勾选后重新生成，按钮随之消失，页面不必改
 */
export const basePageMeta = {
  pageCode: '{{ PageCode }}',
{{~ if CanExport ~}}
  exportPermission: '{{ PermRead }}',
{{~ end ~}}
{{~ if can_import ~}}
  importPermission: '{{ PermCreate }}',
{{~ end ~}}
  batchRemovable: {{ CanDelete }},
{{~ if CanDelete ~}}
  removePermission: '{{ PermDelete }}',
{{~ end ~}}
{{~ if CanStatus ~}}
  statusPermission: '{{ PermUpdate }}',
{{~ end ~}}
  rowKey: 'id',
} satisfies Pick<PageSchema, 'pageCode' | 'exportPermission' | 'importPermission' | 'batchRemovable' | 'removePermission' | 'statusPermission' | 'rowKey'>
{{~ for col in Columns ~}}
{{~ if col.Relation ~}}

/** {{ col.Label | block_comment }}的选项（关联{{ col.Relation.Label | block_comment }}，取 {{ Resource }}.{{ col.CSharpProperty | kebab }}-options；同一加载器与表单下拉共用一次请求） */
export async function load{{ col.CSharpProperty }}Options(): Promise<Array<{ label: string, value: string, parentValue: null | string }>> {
  const { items } = await {{ ResourceCamel }}Api.{{ col.Relation.OptionsMethod }}({})
  return items.map(item => ({ label: item.label, value: item.id, parentValue: item.parentId ?? null }))
}
{{~ end ~}}
{{~ end ~}}
{{~ for col in Columns ~}}
{{~ if col.OptionsKind == "enum" ~}}

/** {{ col.Label | block_comment }}的选项（枚举 {{ col.EnumShortName }}） */
export function {{ col.Field }}Options(t: Translate) {
  return [
{{~ for member in col.EnumMembers ~}}
    {
      label: t('{{ I18nPrefix }}.options.{{ col.PropertySnake }}.{{ member.Snake }}'),
      value: '{{ member.Name }}' as const,
    },
{{~ end ~}}
  ]
}
{{~ end ~}}
{{~ end ~}}

/**
 * 列定义
 *
 * 不进列表但要参与搜索或导入的列以 visible: false 声明：表格与列设置里都不出现，
 * 搜索区照常渲染它的搜索框，导入模板照常带上它这一列
 */
export function baseFields(t: Translate): ListFieldSchema[] {
  return [
{{~ if HasKeyword ~}}
    {
      key: 'keyword',
      title: t('{{ I18nPrefix }}.keyword'),
      dataType: 'string',
      visible: false,
      searchable: true,
      searchPlaceholder: t('{{ I18nPrefix }}.keyword_placeholder'),
      order: 0,
    },
{{~ end ~}}
{{~ for col in Columns ~}}
{{~ importable = can_import && col.IsImportable ~}}
{{~ searchable = col.SearchKind != "" && col.SearchKind != "keyword" ~}}
{{~ if col.InList || searchable || importable ~}}
    {
      key: '{{ col.Field }}',
      title: t('{{ I18nPrefix }}.fields.{{ col.PropertySnake }}'),
      dataType: '{{ col.FieldDataType }}',
{{~ if col.OptionsKind == "relation" || col.OptionsKind == "tree" ~}}
      optionsLoader: load{{ col.CSharpProperty }}Options,
{{~ else if col.OptionsKind == "enum" ~}}
      options: {{ col.Field }}Options(t),
{{~ else if col.OptionsKind == "dict" ~}}
      dictCode: '{{ col.DictCode | ts_string }}',
{{~ else if col.OptionsKind == "const" ~}}
      options: {{ col.ConstValues | select_options col.Label col.TsType 6 }},
{{~ else if col.OptionsKind == "bool" ~}}
      options: [
        {
          label: t('common.statuses.yes'),
          value: 'true',
        },
        {
          label: t('common.statuses.no'),
          value: 'false',
        },
      ],
{{~ end ~}}
{{~ if !col.InList ~}}
      visible: false,
{{~ else if col.IsSortable && !col.Relation && col.ControlKind != "image" && col.ControlKind != "file" ~}}
      sortable: true,
{{~ end ~}}
{{~ if searchable ~}}
      searchable: true,
{{~ end ~}}
{{~ if col.SearchKind == "range" ~}}
      searchRange: true,
{{~ end ~}}
{{~ if col.SearchKind == "multiple" ~}}
      searchMultiple: true,
{{~ end ~}}
{{~ if col.Relation && col.SearchKind == "eq" ~}}
      searchFilterable: true,
{{~ end ~}}
{{~ if importable ~}}
      importable: true,
{{~ if col.IsFormRequired ~}}
      required: true,
{{~ end ~}}
{{~ end ~}}
{{~ if col.InList ~}}
      exportable: true,
{{~ end ~}}
      minWidth: 140,
      order: {{ for.index + 1 }},
    },
{{~ end ~}}
{{~ end ~}}
    {
      key: 'createdAt',
      title: t('{{ I18nPrefix }}.fields.created_at'),
      dataType: 'datetime',
      sortable: true,
      searchable: true,
      searchRange: true,
      exportable: true,
      minWidth: 170,
      order: 99,
    },
  ]
}

/**
 * 页面与行操作（permission 是后端的权限码，导出用读、导入用新建、启停用修改，与各包的页面同一口径）
 */
export function baseActions(t: Translate): NonNullable<PageSchema['actions']> {
{{~ if CanDelete || CanStatus ~}}
  // 确认提示写明操作对象
  const nameOf = (row: object) => {{ if TitleField }}String((row as {{ ClassName }}Row).{{ TitleField }} ?? ''){{ else }}t('{{ I18nPrefix }}.title'){{ end }}
{{~ end ~}}
  return [
{{~ if can_create ~}}
    {
      key: 'create',
      title: t('{{ I18nPrefix }}.actions.create'),
      scope: 'page',
      tone: 'brand',
      icon: 'lucide:plus',
      permission: '{{ PermCreate }}',
    },
{{~ end ~}}
{{~ if can_update ~}}
    {
      key: 'edit',
      title: t('common.actions.edit'),
      scope: 'row',
      icon: 'lucide:pencil',
      permission: '{{ PermUpdate }}',
    },
{{~ end ~}}
{{~ if CanStatus ~}}
    {
      key: 'toggle',
      title: t('{{ I18nPrefix }}.actions.toggle'),
      scope: 'row',
      icon: 'lucide:power',
      confirm: true,
      confirmText: row => statusConfirmText(t, (row as {{ ClassName }}Row).{{ StatusColumn.Field }} === 'Active', nameOf(row)),
      permission: '{{ PermUpdate }}',
    },
{{~ end ~}}
{{~ if CanPrint ~}}
    {
      key: 'print',
      title: t('{{ I18nPrefix }}.actions.print'),
      scope: 'row',
      icon: 'lucide:printer',
      permission: '{{ PermRead }}',
    },
{{~ end ~}}
{{~ if CanDelete ~}}
    {
      key: 'delete',
      title: t('common.actions.delete'),
      scope: 'row',
      icon: 'lucide:trash-2',
      tone: 'danger',
      confirm: true,
      confirmText: row => deleteConfirmText(t, nameOf(row)),
      permission: '{{ PermDelete }}',
    },
{{~ end ~}}
  ]
}
{{~ if HasDetailTables ~}}

/**
 * 明细表的列（主表行展开区；按明细表分组，取明细所在包的文案）
 */
export function detailTableColumns(t: Translate) {
  return {
{{~ for detail in DetailTables ~}}
    {{ detail.ResourceCamel }}: [
{{~ for col in detail.Columns ~}}
{{~ if col.InList && col.ColumnName != detail.ForeignKeyColumn ~}}
      {
        key: '{{ col.Field }}',
        title: t('{{ detail.I18nPrefix }}.fields.{{ col.PropertySnake }}'),
        minWidth: 120,
      },
{{~ end ~}}
{{~ end ~}}
    ],
{{~ end ~}}
  } satisfies Record<string, { key: string, title: string, minWidth: number }[]>
}
{{~ end ~}}

/**
 * 搜索字段到后端筛选的登记（与后端列表查询的白名单同源，改了查询列重新生成即可）
 */
export const queryMapping = {
{{~ if has_filters ~}}
  filters: {
{{~ for col in Columns ~}}
{{~ if col.SearchKind == "eq" || col.SearchKind == "ge" || col.SearchKind == "le" ~}}
    {{ col.Field }}: '{{ col.SearchKind }}',
{{~ end ~}}
{{~ end ~}}
  },
{{~ end ~}}
  ranges: [
{{~ for col in Columns ~}}
{{~ if col.SearchKind == "range" ~}}
    '{{ col.Field }}',
{{~ end ~}}
{{~ end ~}}
    'createdAt',
  ],
{{~ if has_multiples ~}}
  multiples: [
{{~ for col in Columns ~}}
{{~ if col.SearchKind == "multiple" ~}}
    '{{ col.Field }}',
{{~ end ~}}
{{~ end ~}}
  ],
{{~ end ~}}
} satisfies PageQueryMapping

/**
 * 列表查询参数 → 分页请求（列表取数与导出中心共用一份）
 */
export function buildPageQuery(params: SchemaQueryParams) {
  return toPageRequest(params, queryMapping)
}
{{~ if has_form_field ~}}

/**
 * 表单缺省值
 */
export function createDefaultFormModel(): {{ ClassName }}FormModel {
  return {
{{~ # 缺省值取渲染器的 FormDefault：日期与下拉不预填，交给必填校验强制选一次 ~}}
{{~ for col in Columns ~}}
{{~ if col.InForm ~}}
    {{ col.Field }}: {{ col.FormDefault }},
{{~ end ~}}
{{~ end ~}}
  }
}

/**
 * 一行 → 表单（编辑回填；回填表达式与表单模型同源）
 */
export function toFormModel(row: {{ ClassName }}Row): {{ ClassName }}FormModel {
  return {
{{~ for col in Columns ~}}
{{~ if col.InForm ~}}
    {{ col.Field }}: {{ col.FormFromSource | string.replace "$s" ("row." + col.Field) }},
{{~ end ~}}
{{~ end ~}}
  }
}
{{~ end ~}}
{{~ if can_create ~}}

/**
 * 表单 → 新建请求
 */
export function toCreateRequest(form: {{ ClassName }}FormModel): {{ ClassName }}CreateRequest {
  return {
{{~ for col in Columns ~}}
{{~ if col.InCreate ~}}
    {{ col.Field }}: {{ col.FormToWire | string.replace "$v" ("form." + col.Field) | string.replace "$t" (ClassName + "CreateRequest['" + col.Field + "']") }},
{{~ end ~}}
{{~ end ~}}
  }
}
{{~ end ~}}
{{~ if can_update ~}}

/**
 * 表单 → 修改请求（修改请求只带进编辑表单的列）
 */
export function toUpdateRequest(id: string, form: {{ ClassName }}FormModel): {{ ClassName }}UpdateRequest {
  return {
    id,
{{~ for col in Columns ~}}
{{~ if col.InUpdate ~}}
    {{ col.Field }}: {{ col.FormToWire | string.replace "$v" ("form." + col.Field) }},
{{~ end ~}}
{{~ end ~}}
  }
}
{{~ end ~}}
{{~ if can_import ~}}
{{~ if has_import_date ~}}

/** 认得的日期写法：2026-09-30、2026/9/30、2026.9.30，可带 8:30 或 08:30:00 */
const IMPORT_DATE_PATTERN = /^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})(?:[ T](\d{1,2}):(\d{2})(?::(\d{2}))?)?$/

/**
 * 导入的日期单元格按本地时间换成时刻（ISO 8601）
 *
 * 表格软件另存的 CSV 常写成 2026/9/30，原样交给 Date 解析不了；纯 yyyy-MM-dd 交给 Date
 * 又会被当成 UTC 零点，西半球会退一天。所以认得的写法按字面取年月日时分秒，
 * 其余写法已过导入的日期校验，交给 Date 按本地时间解析
 */
function toImportInstant(value: unknown) {
  const text = String(value).trim()
  const matched = IMPORT_DATE_PATTERN.exec(text)
  const date = matched
    ? new Date(Number(matched[1]), Number(matched[2]) - 1, Number(matched[3]), Number(matched[4] ?? 0), Number(matched[5] ?? 0), Number(matched[6] ?? 0))
    : new Date(text)
  return date.toISOString()
}
{{~ end ~}}

/**
 * 导入记录 → 新建请求（导入逐行调用新建操作）
 *
 * 记录里只有表格填了值的列，值已按字段类型换算好（下拉按选项文本反查成值）；
 * 必填列没填过不了导入校验，其余没填的列与新建表单留空同口径补齐
 */
export function toCreateInputFromImport(record: Record<string, unknown>): {{ ClassName }}CreateRequest {
  return {
{{~ for col in Columns ~}}
{{~ if col.InCreate ~}}
    {{ col.Field }}: {{ col.ImportFromRecord | string.replace "$r" ("record." + col.Field) | string.replace "$t" (ClassName + "CreateRequest['" + col.Field + "']") }},
{{~ end ~}}
{{~ end ~}}
  }
}
{{~ end ~}}

/**
 * SchemaPage 的资源：分页{{ if CanDelete }}、删除{{ end }}{{ if CanStatus }}、启停{{ end }}{{ if can_import }}、导入新建{{ end }}{{ if CanExport }}与导出中心{{ end }}
 */
export function baseResource(): SchemaResource<{{ ClassName }}Row> {
  return {
    page: async params => toSchemaPageResult(await {{ ResourceCamel }}Api.list(buildPageQuery(params)), params),
{{~ if CanDelete ~}}
    remove: async id => throwOnFailed(await {{ ResourceCamel }}Api.delete({
      ids: [
        String(id),
      ],
    })),
{{~ end ~}}
{{~ if CanStatus ~}}
    updateStatus: (id, enabled) => {{ ResourceCamel }}Api.setStatus({
      id: String(id),
      {{ StatusColumn.Field }}: enabled ? 'Active' : 'Disabled',
    }),
{{~ end ~}}
{{~ if can_import ~}}
    create: record => {{ ResourceCamel }}Api.create(toCreateInputFromImport(record)),
{{~ end ~}}
{{~ if CanExport ~}}
    // 导出中心按列表操作接单，带着同一组筛选与排序在服务端翻页拉全量
    export: { businessType: '{{ Resource }}.list', buildQuery: buildPageQuery },
{{~ end ~}}
  }
}
