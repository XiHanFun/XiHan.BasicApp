using {{ EntityNamespace }};
using XiHan.Framework.Kernel.Operations;
using XiHan.Framework.Persistence.Abstractions.Repositories;
using XiHan.Framework.Primitives;

namespace {{ Namespace }}.Operations.{{ ResourcePascal }};

/// <summary>
/// 启用或停用{{ DisplayName | xml_doc }}
/// </summary>
/// <remarks>
/// <c>POST /api/{{ Resource }}/{id}:set-status</c>，只改{{ StatusColumn.Label | xml_doc }}
/// </remarks>
/// <param name="repository">仓储</param>
[Operation(Id, Stability = Stability.Preview, Expose = Expose.Http, Permission = {{ ModuleName }}Permissions.{{ ResourcePascal }}Update)]
public sealed class Set{{ ClassName }}Status(IRepository<{{ ClassName }}, Guid> repository) : IOperation<Set{{ ClassName }}StatusRequest, {{ ClassName }}Response>
{
    /// <summary>
    /// 操作 ID
    /// </summary>
    public const string Id = "{{ Resource }}.set-status";

    /// <inheritdoc />
    public async ValueTask<Result<{{ ClassName }}Response>> HandleAsync(Set{{ ClassName }}StatusRequest request, InvocationContext context)
    {
        ArgumentNullException.ThrowIfNull(request);
        ArgumentNullException.ThrowIfNull(context);
        if (!(await repository.FindAsync(request.Id, context.CancellationToken).ConfigureAwait(false)).TryGetValue(out var entity))
        {
            return Error.NotFound({{ ModuleName }}Errors.{{ ClassName }}NotFound, {{ ModuleName }}Messages.{{ ClassName }}NotFound, MessageArguments.Of(("id", request.Id)));
        }

        entity.{{ StatusColumn.CSharpProperty }} = request.{{ StatusColumn.CSharpProperty }};
        var updated = await repository.UpdateAsync(entity, context.CancellationToken).ConfigureAwait(false);
        return updated.IsFailure ? updated.Error! : {{ ClassName }}Response.From(entity);
    }
}
{{~ end ~}}
