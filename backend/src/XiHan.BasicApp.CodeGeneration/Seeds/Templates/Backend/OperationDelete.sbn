using {{ EntityNamespace }};
using XiHan.BasicApp.Contracts.Batch;
{{~ if IsTree ~}}
using XiHan.Framework.Domain.Specifications;
{{~ end ~}}
using XiHan.Framework.Kernel.Operations;
{{~ if IsTree ~}}
using XiHan.Framework.Persistence.Abstractions.Queries;
{{~ end ~}}
using XiHan.Framework.Persistence.Abstractions.Repositories;
using XiHan.Framework.Primitives;

namespace {{ Namespace }}.Operations.{{ ResourcePascal }};

/// <summary>
/// 批量删除{{ DisplayName | xml_doc }}
/// </summary>
/// <remarks>
/// <c>DELETE /api/{{ Resource }}?ids=...</c>。逐项：不存在即 <c>{{ ModuleName }}Errors.{{ ClassName }}NotFound</c>{{ if IsTree }}，还有下级即 <c>{{ ModuleName }}Errors.{{ ClassName }}HasChildren</c>（删了上级，下级会整枝挪成顶层）{{ end }}
/// </remarks>
/// <param name="repository">仓储</param>
[Operation(Id, Stability = Stability.Preview, Expose = Expose.Http, Permission = {{ ModuleName }}Permissions.{{ ResourcePascal }}Delete)]
public sealed class Delete{{ ResourcePascal }}(IRepository<{{ ClassName }}, Guid> repository) : IOperation<{{ ClassName }}IdsRequest, BatchResult>
{
    /// <summary>
    /// 操作 ID
    /// </summary>
    public const string Id = "{{ Resource }}.delete";

    /// <inheritdoc />
    public async ValueTask<Result<BatchResult>> HandleAsync({{ ClassName }}IdsRequest request, InvocationContext context)
    {
        ArgumentNullException.ThrowIfNull(request);
        ArgumentNullException.ThrowIfNull(context);
        var found = (await repository.FindManyAsync(request.Ids, context.CancellationToken).ConfigureAwait(false)).ToDictionary(static e => e.Id);
        var succeeded = new List<Guid>();
        var failed = new List<BatchFailure>();
        foreach (var id in request.Ids.Distinct())
        {
            if (!found.TryGetValue(id, out var entity))
            {
                failed.Add(BatchFailure.From(id, Error.NotFound({{ ModuleName }}Errors.{{ ClassName }}NotFound, {{ ModuleName }}Messages.{{ ClassName }}NotFound, MessageArguments.Of(("id", id)))));
                continue;
            }

{{~ if IsTree ~}}
            var nodeId = entity.Id;
            if (await repository.CountAsync(EntityQuery.All<{{ ClassName }}>().Where(new Specification<{{ ClassName }}>(e => e.{{ TreeParentColumn.CSharpProperty }} == nodeId)), context.CancellationToken).ConfigureAwait(false) > 0)
            {
                failed.Add(BatchFailure.From(id, Error.Conflict({{ ModuleName }}Errors.{{ ClassName }}HasChildren, {{ ModuleName }}Messages.{{ ClassName }}HasChildren, MessageArguments.Of(("id", id)))));
                continue;
            }

{{~ end ~}}
            var removed = await repository.RemoveAsync(entity, context.CancellationToken).ConfigureAwait(false);
            if (removed.IsFailure)
            {
                return removed.Error!;
            }

            succeeded.Add(id);
        }

        return new BatchResult(succeeded, failed);
    }
}
{{~ end ~}}
