using {{ EntityNamespace }};
{{~ if unique ~}}
using XiHan.Framework.Domain.Specifications;
{{~ end ~}}
using XiHan.Framework.Kernel.Operations;
{{~ if unique || parent ~}}
using XiHan.Framework.Persistence.Abstractions.Queries;
{{~ end ~}}
using XiHan.Framework.Persistence.Abstractions.Repositories;
using XiHan.Framework.Primitives;

namespace {{ Namespace }}.Operations.{{ ResourcePascal }};

/// <summary>
/// 修改{{ DisplayName | xml_doc }}
/// </summary>
/// <remarks>
/// <c>PUT /api/{{ Resource }}/{id}</c>，整体替换可编辑的字段。{{ for col in UpdateUniqueColumns }}{{ col.Label | xml_doc }}租户内唯一；{{ end }}{{ if parent }}上级要存在，不能是自己或自己的下级（挂到下级下面这一枝会成环、从树上断开）；{{ end }}
/// </remarks>
/// <param name="repository">仓储</param>
[Operation(Id, Stability = Stability.Preview, Expose = Expose.Http, Permission = {{ ModuleName }}Permissions.{{ ResourcePascal }}Update)]
public sealed class Update{{ ClassName }}(IRepository<{{ ClassName }}, Guid> repository) : IOperation<Update{{ ClassName }}Request, {{ ClassName }}Response>
{
    /// <summary>
    /// 操作 ID
    /// </summary>
    public const string Id = "{{ Resource }}.update";

    /// <inheritdoc />
    public async ValueTask<Result<{{ ClassName }}Response>> HandleAsync(Update{{ ClassName }}Request request, InvocationContext context)
    {
        ArgumentNullException.ThrowIfNull(request);
        ArgumentNullException.ThrowIfNull(context);
        if (!(await repository.FindAsync(request.Id, context.CancellationToken).ConfigureAwait(false)).TryGetValue(out var entity))
        {
            return Error.NotFound({{ ModuleName }}Errors.{{ ClassName }}NotFound, {{ ModuleName }}Messages.{{ ClassName }}NotFound, MessageArguments.Of(("id", request.Id)));
        }

{{~ if unique ~}}
        var id = entity.Id;
{{~ end ~}}
{{~ for col in UpdateUniqueColumns ~}}
        var {{ col.Field }}Value = request.{{ col.CSharpProperty }}{{ if col.IsString }}{{ if col.IsNullableType }}?{{ end }}.Trim(){{ end }};
        if ({{ if col.IsString }}!string.IsNullOrEmpty({{ col.Field }}Value) && {{ else if col.IsNullableType }}{{ col.Field }}Value is not null && {{ end }}await repository.CountAsync(EntityQuery.All<{{ ClassName }}>().Where(new Specification<{{ ClassName }}>(e => e.{{ col.CSharpProperty }} == {{ col.Field }}Value && e.Id != id)), context.CancellationToken).ConfigureAwait(false) > 0)
        {
            return Error.Conflict({{ ModuleName }}Errors.{{ ClassName }}{{ col.CSharpProperty }}Taken, {{ ModuleName }}Messages.{{ ClassName }}{{ col.CSharpProperty }}Taken, MessageArguments.Of(("value", {{ col.Field }}Value)));
        }

{{~ end ~}}
{{~ if parent ~}}
        var parentId = request.{{ TreeParentColumn.CSharpProperty }}{{ if TreeParentColumn.IsNullableType }} ?? Guid.Empty{{ end }};
        if (parentId != Guid.Empty && !await ParentAllowedAsync(entity.Id, parentId, context.CancellationToken).ConfigureAwait(false))
        {
            return Error.Validation({{ ModuleName }}Errors.{{ ClassName }}InvalidParent, {{ ModuleName }}Messages.{{ ClassName }}InvalidParent, MessageArguments.Of(("id", parentId)));
        }

{{~ end ~}}
        request.ApplyTo(entity);
        var updated = await repository.UpdateAsync(entity, context.CancellationToken).ConfigureAwait(false);
        return updated.IsFailure ? updated.Error! : {{ ClassName }}Response.From(entity);
    }
{{~ if parent ~}}

    // 上级要存在，且沿上级链走不回自己；取全部行在内存里走（树表数据量小，也避开递归查询的方言差异）
    private async Task<bool> ParentAllowedAsync(Guid id, Guid parentId, CancellationToken cancellationToken)
    {
        if (parentId == id)
        {
            return false;
        }

        var parents = (await repository.ListAsync(EntityQuery.All<{{ ClassName }}>(), cancellationToken).ConfigureAwait(false))
            .ToDictionary(static e => e.Id, static e => (Guid?)e.{{ TreeParentColumn.CSharpProperty }});
        if (!parents.ContainsKey(parentId))
        {
            return false;
        }

        var visited = new HashSet<Guid>();
        for (Guid? cursor = parentId; cursor is { } node && node != Guid.Empty && visited.Add(node); cursor = parents.GetValueOrDefault(node))
        {
            if (node == id)
            {
                return false;
            }
        }

        return true;
    }
{{~ end ~}}
}
{{~ end ~}}
