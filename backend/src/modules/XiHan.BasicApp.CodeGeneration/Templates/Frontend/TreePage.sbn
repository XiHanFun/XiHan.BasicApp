{{~ # 预计算控件需求标志（避免按列重复 import 造成 eslint no-unused） ~}}
{{~ # 父列单独判：它在表单里渲染成树形下拉，不走下面这段控件级联 ~}}
{{~ has_form_field = false ~}}
{{~ parent_in_form = false ~}}
{{~ for col in Columns ~}}
{{~ if col.InForm ~}}
{{~ has_form_field = true ~}}
{{~ if col.ColumnName == TreeParentColumn.ColumnName ~}}
{{~ parent_in_form = true ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ has_text_input = false ~}}
{{~ has_number = false ~}}
{{~ has_switch = false ~}}
{{~ has_select = false ~}}
{{~ has_enum_select = false ~}}
{{~ has_dict_select = false ~}}
{{~ has_dynamic_select = false ~}}
{{~ has_upload = false ~}}
{{~ has_relation_select = false ~}}
{{~ has_relation_tree = false ~}}
{{~ has_date_picker = false ~}}
{{~ has_date_only = false ~}}
{{~ has_date_time = false ~}}
{{~ has_time_input = false ~}}
{{~ has_long_input = false ~}}
{{~ # 控件由渲染器的 col.ControlKind 单点决定；父列除外，它恒是树形下拉。 ~}}
{{~ for col in Columns ~}}
{{~ if col.InForm && col.ColumnName != TreeParentColumn.ColumnName ~}}
{{~ if col.ControlKind == "switch" ~}}
{{~ has_switch = true ~}}
{{~ else if col.ControlKind == "select" ~}}
{{~ # 关联表的候选随目标表增长，用可输入筛选的 XCombobox；其余下拉选项有限，仍用 XSelect ~}}
{{~ if col.Relation ~}}
{{~ has_relation_select = true ~}}
{{~ else ~}}
{{~ has_select = true ~}}
{{~ if col.DictSelectorType != "ConstSelector" ~}}
{{~ has_dynamic_select = true ~}}
{{~ end ~}}
{{~ end ~}}
{{~ if col.EnumTypeShortName ~}}
{{~ has_enum_select = true ~}}
{{~ end ~}}
{{~ if col.DictSelectorType == "DictSelector" ~}}
{{~ has_dict_select = true ~}}
{{~ end ~}}
{{~ else if col.ControlKind == "treeselect" ~}}
{{~ has_relation_tree = true ~}}
{{~ else if col.ControlKind == "date" ~}}
{{~ has_date_picker = true ~}}
{{~ has_date_only = true ~}}
{{~ else if col.ControlKind == "datetime" ~}}
{{~ has_date_picker = true ~}}
{{~ has_date_time = true ~}}
{{~ else if col.ControlKind == "image" || col.ControlKind == "file" ~}}
{{~ has_upload = true ~}}
{{~ else if col.ControlKind == "number" ~}}
{{~ has_number = true ~}}
{{~ else ~}}
{{~ has_text_input = true ~}}
{{~ if col.ControlKind == "time" ~}}
{{~ has_time_input = true ~}}
{{~ end ~}}
{{~ if col.IsLongColumn ~}}
{{~ has_long_input = true ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ # 提交前校验覆盖两类列（都没有就不产出校验函数，避免未被引用）： ~}}
{{~ # 一是必填列——判空表达式由渲染器按控件给出（FormEmptyCheck），非空且没有缺省值的列也按必填； ~}}
{{~ # 二是 long 与时间列——前端用文本框承载，格式不对后端会静默落成 0 或默认值。 ~}}
{{~ # 整数列不必再校验：数字框按 col.NumberPrecision 收值，整数列是 0 位小数。 ~}}
{{~ # 父级不在其列：不选即作为根节点，永不必填 ~}}
{{~ has_required = false ~}}
{{~ for col in Columns ~}}
{{~ if col.InForm && col.ColumnName != TreeParentColumn.ColumnName && col.FormEmptyCheck ~}}
{{~ has_required = true ~}}
{{~ end ~}}
{{~ end ~}}
{{~ has_validation = has_required || has_long_input || has_time_input ~}}
{{~ # 操作裁剪标志（EnabledActions 门控；读取基线 tree/detail 始终生成） ~}}
{{~ # 一列都不进表单时不产弹窗与增改按钮：空表单没有意义，且会留下未被引用的 import ~}}
{{~ can_create = CanCreate && has_form_field ~}}
{{~ can_update = CanUpdate && has_form_field ~}}
{{~ # 导入逐行调新增接口（引擎保证勾了导入就一定勾了新增），与 schema 里的导入字段同一判据 ~}}
{{~ can_import = CanImport && can_create ~}}
{{~ has_modal = can_create || can_update ~}}
{{~ has_row_action = can_update || CanDelete || CanStatus || CanPrint ~}}
{{~ has_actions = can_create || can_update || CanDelete || CanStatus || CanPrint ~}}
{{~ # 保存、删除、启停后刷新列表；只开打印时不需要 ~}}
{{~ has_reload = has_modal || CanDelete || CanStatus ~}}
{{~ # 打印时图片列要换成可访问地址（字段存的是文件主键） ~}}
{{~ has_print_image = false ~}}
{{~ for col in Columns ~}}
{{~ if CanPrint && col.InDetail && col.ControlKind == "image" ~}}
{{~ has_print_image = true ~}}
{{~ end ~}}
{{~ end ~}}
<!--
  {{ TableComment | html_comment }}管理页（树形）

  本文件仅在首次生成时创建，重新生成时不会被覆盖——页面结构与表单标记可以放心改。
  列定义/表单默认值来自 ./{{ ClassNameKebab }}.schema.ts（它在生成的 base* 之上做 transform，
  会随表结构变化自动更新）；需要增删列或改渲染，改那个文件而不是这里。

  树形取数走 resource.tree（返回嵌套数组、不分页），父级选择器复用同一份树数据。

  文案为中文字面量：接 i18n 时把它们换成 t('{{ ModuleName | string.downcase }}.{{ ClassNameSnake }}.xxx')，
  并在语言包补上对应键。
-->
<script setup lang="ts">
{{~ if has_modal ~}}
import type { {{ ClassName }}FormModel } from './{{ ClassNameKebab }}.schema'
{{~ end ~}}
import type {
{{~ if can_create ~}}
  {{ ClassName }}CreateDto,
{{~ end ~}}
{{~ if can_update ~}}
  {{ ClassName }}DetailDto,
{{~ end ~}}
{{~ if has_row_action ~}}
  {{ ClassName }}ListItemDto,
{{~ end ~}}
  {{ ClassName }}TreeNodeDto,
{{~ if can_update ~}}
  {{ ClassName }}UpdateDto,
{{~ end ~}}
} from '@/api/modules/{{ ModuleName | string.downcase }}/{{ ClassNameKebab }}.types'
import type { PageSchema{{ if has_actions }}, SchemaActionPayload, SchemaPageInstance{{ end }} } from '~/components'
{{~ if has_modal && (has_dynamic_select || parent_in_form) ~}}
import type { {{ if has_dynamic_select }}SelectOption{{ end }}{{ if has_dynamic_select && parent_in_form }}, {{ end }}{{ if parent_in_form }}TreeSelectOption{{ end }} } from '~/types'
{{~ end ~}}
{{~ if has_modal ~}}
import { XhFieldControl, XhFieldErrorText, XhFieldLabel, XhFieldRoot, XhFormFieldGroup, XhFormRoot{{ if has_switch }}, XhSwitch{{ end }} } from '@xihan-ui/vue'
{{~ end ~}}
{{~ if has_modal ~}}
import { computed, ref, useId } from 'vue'
{{~ else ~}}
import { ref } from 'vue'
{{~ end ~}}
import { {{ ClassNameCamel }}Api } from '@/api/modules/{{ ModuleName | string.downcase }}/{{ ClassNameKebab }}'
{{~ if has_modal && has_upload ~}}
import XFileRefUpload from '@/components/FileRefUpload.vue'
{{~ end ~}}
import { SchemaPage{{ if has_modal && has_relation_select }}, XCombobox{{ end }}{{ if has_modal && has_date_picker }}, XDatePicker{{ end }}{{ if has_modal }}, XEditModal{{ end }}{{ if has_modal && has_text_input }}, XInput{{ end }}{{ if has_modal && has_number }}, XNumberInput{{ end }}{{ if has_modal && has_select }}, XSelect{{ end }}{{ if has_modal && (parent_in_form || has_relation_tree) }}, XTreeSelect{{ end }} } from '~/components'
{{~ composable_imports = [] ~}}
{{~ if has_print_image ~}}
{{~ composable_imports = composable_imports | array.add "resolveAvatarUrl" ~}}
{{~ end ~}}
{{~ if has_actions ~}}
{{~ composable_imports = composable_imports | array.add "toast" ~}}
{{~ end ~}}
{{~ if has_modal && (has_relation_select || has_relation_tree) ~}}
{{~ composable_imports = composable_imports | array.add "useAsyncOptions" ~}}
{{~ end ~}}
{{~ if has_modal && has_dict_select ~}}
{{~ composable_imports = composable_imports | array.add "useDictOptions" ~}}
{{~ end ~}}
{{~ if (composable_imports | array.size) > 0 ~}}
import { {{ composable_imports | array.join ", " }} } from '~/composables'
{{~ end ~}}
{{~ if has_modal && has_enum_select ~}}
import { useEnumOptions } from '~/hooks'
{{~ end ~}}
{{~ if CanPrint ~}}
import { previewPrintByCode } from '~/printing'
{{~ end ~}}
{{~ if has_modal && has_relation_tree ~}}
import { relationOptionsToTree } from '~/utils'
{{~ end ~}}
import { {{ if has_actions }}actions, {{ end }}{{ if CanExport }}buildPageQuery, {{ end }}{{ if has_modal }}createDefaultForm, {{ end }}fields, pageMeta{{ if can_import }}, toCreateInputFromImport{{ end }} } from './{{ ClassNameKebab }}.schema'

defineOptions({ name: '{{ ClassName }}Page' })
{{~ if has_modal ~}}

/** 编辑弹窗的保存钮靠这个 id 关联到表单，点它才会走整表校验 */
const editFormId = useId()
{{~ end ~}}
{{~ if has_actions ~}}

const schemaPageRef = ref<SchemaPageInstance | null>(null)
{{~ end ~}}
{{~ if has_reload ~}}

function reloadList() {
  void schemaPageRef.value?.reload()
}
{{~ end ~}}

/** 父级选择器数据源：与表格共用同一次树查询结果 */
const treeNodes = ref<{{ ClassName }}TreeNodeDto[]>([])

const schema: PageSchema = {
  ...pageMeta,
  fields,
{{~ if has_actions ~}}
  actions,
{{~ end ~}}
  resource: {
    tree: async () => {
      const nodes = await {{ ClassNameCamel }}Api.tree()
      treeNodes.value = nodes ?? []
      return (nodes ?? []) as unknown as Record<string, unknown>[]
    },
{{~ if CanDelete ~}}
    remove: id => {{ ClassNameCamel }}Api.delete(id),
{{~ end ~}}
{{~ if CanStatus ~}}
    // 批量启用/停用：框架按行调用
    updateStatus: (id, enabled) => {{ ClassNameCamel }}Api.updateStatus({ basicId: id, {{ StatusColumn.TsProperty }}: enabled ? 'Enabled' : 'Disabled' }),
{{~ end ~}}
{{~ if can_import ~}}
    // 导入：逐行调新增接口，记录到入参的换算在 schema 里随表结构更新；导入完成后框架会重取整棵树
    create: record => {{ ClassNameCamel }}Api.create(toCreateInputFromImport(record)),
{{~ end ~}}
{{~ if CanExport ~}}
    // 导出中心：业务类型即页面码，后端生成的 {{ ClassName }}ExportProvider 按分页接口拉全量
    export: { businessType: pageMeta.pageCode, buildQuery: buildPageQuery },
{{~ end ~}}
  },
}
{{~ if has_actions ~}}

function onAction(payload: SchemaActionPayload) {
{{~ if has_row_action ~}}
  const row = payload.row as unknown as {{ ClassName }}ListItemDto | undefined
{{~ end ~}}
  switch (payload.key) {
{{~ if can_create ~}}
    case 'create':
      handleAdd()
      break
{{~ end ~}}
{{~ if can_update ~}}
    case 'edit':
      if (row) {
        void handleEdit(row)
      }
      break
{{~ end ~}}
{{~ if CanDelete ~}}
    case 'delete':
      if (row) {
        void handleDelete(row)
      }
      break
{{~ end ~}}
{{~ if CanStatus ~}}
    case 'toggle':
      if (row) {
        void handleToggleStatus(row)
      }
      break
{{~ end ~}}
{{~ if CanPrint ~}}
    case 'print':
      if (row) {
        void handlePrint(row)
      }
      break
{{~ end ~}}
  }
}
{{~ end ~}}
{{~ if has_modal ~}}

{{~ # 布尔列排除在外：它渲染成开关，不消费选项 ~}}
{{~ for col in Columns ~}}
{{~ if col.InForm && col.ColumnName != TreeParentColumn.ColumnName && col.ControlKind == "select" && col.DictSelectorType == "ConstSelector" ~}}
/** {{ col.Label | block_comment }}常量选项 */
const {{ col.TsProperty }}ConstOptions = {{ col.ConstValues | select_options col.Label col.TsType }}
{{~ else if col.InForm && col.ColumnName != TreeParentColumn.ColumnName && col.ControlKind == "select" && col.EnumTypeShortName ~}}
/** {{ col.Label | block_comment }}枚举选项（后端枚举元数据按 X-Language 返回标签） */
const {{ col.TsProperty }}Options = useEnumOptions('{{ col.EnumTypeShortName }}')
{{~ else if col.InForm && col.ColumnName != TreeParentColumn.ColumnName && col.ControlKind == "select" && col.Relation ~}}
/** {{ col.Label | block_comment }}选项（关联{{ col.Relation.Label | block_comment }}，选中值为其主键） */
const {{ col.TsProperty }}Options = useAsyncOptions({{ ClassNameCamel }}Api.{{ col.Relation.OptionsMethodCamel }})
{{~ else if col.InForm && col.ColumnName != TreeParentColumn.ColumnName && col.ControlKind == "treeselect" ~}}
/** {{ col.Label | block_comment }}树形选项（关联{{ col.Relation.Label | block_comment }}，按上级组树，选中值为其主键） */
const {{ col.TsProperty }}Relation = useAsyncOptions({{ ClassNameCamel }}Api.{{ col.Relation.OptionsMethodCamel }})
const {{ col.TsProperty }}TreeOptions = computed(() => relationOptionsToTree({{ col.TsProperty }}Relation.value))
{{~ else if col.InForm && col.ColumnName != TreeParentColumn.ColumnName && col.ControlKind == "select" && col.DictSelectorType == "DictSelector" ~}}
/** {{ col.Label | block_comment }}字典选项（字典 {{ col.DictCode | block_comment }}，选中值为字典项编码；停用项只回显不能选） */
const {{ col.TsProperty }}Options = useDictOptions('{{ col.DictCode | ts_string }}')
{{~ else if col.InForm && col.ColumnName != TreeParentColumn.ColumnName && col.ControlKind == "select" ~}}
{{~ # 只剩枚举解析不出来这一种：引擎已告警，这里产出禁用占位项，重新同步表结构后即接通 ~}}
/** {{ col.Label | block_comment }}选项来源未接通（枚举 {{ col.EnumTypeName | block_comment }} 未解析，对表执行重新同步后重新生成） */
const {{ col.TsProperty }}Options = [{ label: '选项来源未接通', value: -1, disabled: true }]
{{~ end ~}}
{{~ end ~}}
const modalVisible = ref(false)
const submitLoading = ref(false)
const form = ref<{{ ClassName }}FormModel>(createDefaultForm())
const modalTitle = computed(() => (form.value.basicId ? '编辑{{ DisplayName | ts_string }}' : '新增{{ DisplayName | ts_string }}'))
{{~ if parent_in_form ~}}

/** 编辑时排除自身：整枝过滤掉，其后代也随之不出现，避免把节点挂到自己的子树下形成环 */
const parentOptions = computed<TreeSelectOption[]>(() => {
  const excludeId = form.value.basicId
  const map = (nodes: {{ ClassName }}TreeNodeDto[]): TreeSelectOption[] =>
    nodes
      .filter(node => node.basicId !== excludeId)
      .map(node => ({
        children: node.children?.length ? map(node.children) : undefined,
        label: String(node.{{ TreeNameColumn.TsProperty }}),
        value: node.basicId,
      }))
  return map(treeNodes.value)
})
{{~ end ~}}
{{~ end ~}}
{{~ if can_create ~}}

function handleAdd() {
  form.value = createDefaultForm()
  modalVisible.value = true
}
{{~ end ~}}
{{~ if can_update ~}}

async function handleEdit(row: {{ ClassName }}ListItemDto) {
  // 详情取不到就退回列表行：列表列是详情列的子集，缺的字段在下面按可空/默认值兜住
  let detail: {{ ClassName }}DetailDto | null = null
  try {
    detail = await {{ ClassNameCamel }}Api.detail(row.basicId)
  }
  catch (error) {
    toast.danger((error as Error)?.message || '加载详情失败')
  }
  const src = (detail ?? row) as {{ ClassName }}DetailDto
  form.value = {
    basicId: row.basicId,
{{~ # 回填表达式取渲染器的 FormFromSource（与表单模型同源）；$s 换成详情里的同名字段。 ~}}
{{~ # 非空父级以 0 表示根节点，回填成「未选」，下拉里才不会出现一个找不到的 0 ~}}
{{~ for col in Columns ~}}
{{~ if col.InForm ~}}
{{~ if col.ColumnName == TreeParentColumn.ColumnName && !col.IsNullable ~}}
    {{ col.TsProperty }}: src.{{ col.TsProperty }} && src.{{ col.TsProperty }} !== '0' ? src.{{ col.TsProperty }} : null,
{{~ else ~}}
    {{ col.TsProperty }}: {{ col.FormFromSource | string.replace "$s" ("src." + col.TsProperty) }},
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
  }
  modalVisible.value = true
}
{{~ end ~}}
{{~ if CanDelete ~}}

async function handleDelete(row: {{ ClassName }}ListItemDto) {
  try {
    await {{ ClassNameCamel }}Api.delete(row.basicId)
    toast.success('删除成功')
    reloadList()
  }
  catch (error) {
    toast.danger((error as Error)?.message || '删除失败')
  }
}
{{~ end ~}}
{{~ if CanStatus ~}}

async function handleToggleStatus(row: {{ ClassName }}ListItemDto) {
  const enable = row.{{ StatusColumn.TsProperty }} !== 'Enabled'
  try {
    await {{ ClassNameCamel }}Api.updateStatus({ basicId: row.basicId, {{ StatusColumn.TsProperty }}: enable ? 'Enabled' : 'Disabled' })
    toast.success(enable ? '已启用' : '已停用')
    reloadList()
  }
  catch (error) {
    toast.danger((error as Error)?.message || (enable ? '启用失败' : '停用失败'))
  }
}
{{~ end ~}}
{{~ if CanPrint ~}}

/**
 * 打印：取详情，选项列换成显示名称{{ if has_print_image }}、图片换成可访问地址{{ end }}，按页面码取打印模板预览。
 * 模板在「打印模板」页新建，编码同为页面码、数据源选本页。
 */
async function handlePrint(row: {{ ClassName }}ListItemDto) {
  try {
    const detail = await {{ ClassNameCamel }}Api.detail(row.basicId)
    const source = (detail ?? row) as unknown as Record<string, unknown>
    const data: Record<string, unknown> = { ...source, ...schemaPageRef.value?.formatRow(source) }
{{~ for col in Columns ~}}
{{~ if col.InDetail && col.ControlKind == "image" ~}}
    data.{{ col.TsProperty }} = await resolveAvatarUrl(source.{{ col.TsProperty }} as null | string)
{{~ end ~}}
{{~ end ~}}
    await previewPrintByCode(pageMeta.pageCode, data)
  }
  catch (error) {
    toast.danger((error as Error)?.message || '打印失败')
  }
}
{{~ end ~}}
{{~ if has_modal ~}}
{{~ if has_date_only ~}}

/**
 * 纯日期列按本地年月日发送。
 *
 * 走 toISOString 会把「本地零点」换算成 UTC，东八区下 8-31 会退成 8-30，
 * 存进物理 DATE 列就少了一天。日期控件给出的也正是本地零点的时间戳。
 */
function toDateOnly(value: number | null | undefined) {
  if (value == null || Number.isNaN(value)) {
    return ''
  }
  const date = new Date(value)
  const month = String(date.getMonth() + 1).padStart(2, '0')
  const day = String(date.getDate()).padStart(2, '0')
  return `${date.getFullYear()}-${month}-${day}`
}
{{~ end ~}}
{{~ if has_date_time ~}}

/**
 * 日期时间列按本地时间文本发送（yyyy-MM-dd HH:mm:ss），与后端下发、导入的口径一致。
 *
 * 带时刻的日期控件给出本地时刻的时间戳；同样不走 toISOString，免得换算成 UTC 后差出时区。
 */
function toDateTime(value: number | null | undefined) {
  if (value == null || Number.isNaN(value)) {
    return ''
  }
  const date = new Date(value)
  const pad = (part: number) => String(part).padStart(2, '0')
  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`
}
{{~ end ~}}
{{~ if has_validation ~}}
{{~ if has_long_input ~}}

/** long 列在前端按字符串承载（雪花 ID 超出 Number 安全范围），提交前按整数校验 */
const INTEGER_PATTERN = /^-?\d+$/
{{~ end ~}}
{{~ if has_time_input ~}}

/** 时间列脚手架用文本框承载，提交前按 HH:mm(:ss) 校验，避免后端解析失败静默落成默认值 */
const TIME_PATTERN = /^\d{1,2}:\d{2}(?::\d{2})?$/
{{~ end ~}}

{{~ # 只勾单侧新增/编辑的列在另一侧被 v-if 藏起来，校验也得跟着分侧 ~}}
/** 提交前校验：必填项不得为空；long 与时间格式不对时后端会静默落成 0 或默认值，先拦下 */
function validateForm() {
{{~ for col in Columns ~}}
{{~ side_guard = "" ~}}
{{~ if col.InCreate && !col.InUpdate ~}}
{{~ side_guard = "!form.value.basicId && " ~}}
{{~ else if col.InUpdate && !col.InCreate ~}}
{{~ side_guard = "form.value.basicId && " ~}}
{{~ end ~}}
{{~ if col.InForm && col.ColumnName != TreeParentColumn.ColumnName && col.FormEmptyCheck ~}}
{{~ empty_check = col.FormEmptyCheck | string.replace "$v" ("form.value." + col.TsProperty) ~}}
  if ({{ if side_guard == "" }}{{ empty_check }}{{ else }}{{ side_guard }}({{ empty_check }}){{ end }}) {
    toast.warning('{{ col.FormRequiredVerb }}{{ col.Label | ts_string }}')
    return false
  }
{{~ end ~}}
{{~ if col.InForm && col.ColumnName != TreeParentColumn.ColumnName && col.IsLongColumn && (col.ControlKind == "text" || col.ControlKind == "textarea") ~}}
  if ({{ side_guard }}form.value.{{ col.TsProperty }} && !INTEGER_PATTERN.test(String(form.value.{{ col.TsProperty }}))) {
    toast.warning('{{ col.Label | ts_string }}只能填整数')
    return false
  }
{{~ end ~}}
{{~ if col.InForm && col.ColumnName != TreeParentColumn.ColumnName && col.ControlKind == "time" ~}}
  if ({{ side_guard }}form.value.{{ col.TsProperty }} && !TIME_PATTERN.test(String(form.value.{{ col.TsProperty }}))) {
    toast.warning('{{ col.Label | ts_string }}格式应为 HH:mm 或 HH:mm:ss')
    return false
  }
{{~ end ~}}
{{~ end ~}}
  return true
}
{{~ end ~}}

async function handleSubmit() {
{{~ if has_validation ~}}
  if (!validateForm()) {
    return
  }

{{~ end ~}}
{{~ if can_update && !can_create ~}}
  // 页面没有新增入口，basicId 必然已有；缺了就明说，别静默提示保存成功
  const editingId = form.value.basicId
  if (!editingId) {
    toast.warning('缺少记录标识，无法保存')
    return
  }

{{~ end ~}}
  submitLoading.value = true
  try {
{{~ if can_update && can_create ~}}
    if (form.value.basicId) {
      const updateInput: {{ ClassName }}UpdateDto = {
        basicId: form.value.basicId,
{{~ for col in Columns ~}}
{{~ if col.InUpdate ~}}
        {{ col.TsProperty }}: {{ if col.ColumnName == TreeParentColumn.ColumnName }}form.value.{{ col.TsProperty }} || {{ if col.IsNullable }}null{{ else }}'0'{{ end }}{{ else }}{{ col.FormToWire | string.replace "$v" ("form.value." + col.TsProperty) }}{{ end }},
{{~ end ~}}
{{~ end ~}}
      }
      await {{ ClassNameCamel }}Api.update(updateInput)
    }
    else {
      const createInput: {{ ClassName }}CreateDto = {
{{~ for col in Columns ~}}
{{~ if col.InCreate ~}}
        {{ col.TsProperty }}: {{ if col.ColumnName == TreeParentColumn.ColumnName }}form.value.{{ col.TsProperty }} || {{ if col.IsNullable }}null{{ else }}'0'{{ end }}{{ else }}{{ col.FormToWire | string.replace "$v" ("form.value." + col.TsProperty) }}{{ end }},
{{~ end ~}}
{{~ end ~}}
      }
      await {{ ClassNameCamel }}Api.create(createInput)
    }
{{~ else if can_update ~}}
    const updateInput: {{ ClassName }}UpdateDto = {
      basicId: editingId,
{{~ for col in Columns ~}}
{{~ if col.InUpdate ~}}
      {{ col.TsProperty }}: {{ if col.ColumnName == TreeParentColumn.ColumnName }}form.value.{{ col.TsProperty }} || {{ if col.IsNullable }}null{{ else }}'0'{{ end }}{{ else }}{{ col.FormToWire | string.replace "$v" ("form.value." + col.TsProperty) }}{{ end }},
{{~ end ~}}
{{~ end ~}}
    }
    await {{ ClassNameCamel }}Api.update(updateInput)
{{~ else ~}}
    const createInput: {{ ClassName }}CreateDto = {
{{~ for col in Columns ~}}
{{~ if col.InCreate ~}}
      {{ col.TsProperty }}: {{ if col.ColumnName == TreeParentColumn.ColumnName }}form.value.{{ col.TsProperty }} || {{ if col.IsNullable }}null{{ else }}'0'{{ end }}{{ else }}{{ col.FormToWire | string.replace "$v" ("form.value." + col.TsProperty) }}{{ end }},
{{~ end ~}}
{{~ end ~}}
    }
    await {{ ClassNameCamel }}Api.create(createInput)
{{~ end ~}}
    toast.success('保存成功')
    modalVisible.value = false
    reloadList()
  }
  catch (error) {
    toast.danger((error as Error)?.message || '保存失败')
  }
  finally {
    submitLoading.value = false
  }
}
{{~ end ~}}
</script>

<template>
{{~ if has_modal ~}}
  <SchemaPage{{ if has_actions }} ref="schemaPageRef"{{ end }} :schema="schema"{{ if has_actions }} @action="onAction"{{ end }}>
    <XEditModal
      v-model:show="modalVisible"
      :title="modalTitle"
      :loading="submitLoading"
      :form-id="editFormId"
    >
      <XhFormRoot
        :id="editFormId"
        v-model:values="form"
        validate-on="blur"
        class="xh-edit-form-grid"
        @submit="handleSubmit"
      >
{{~ for col in Columns ~}}
{{~ if col.InForm ~}}
{{~ # 控件按 col.ControlKind 分派，与表单模型、回填、提交同源；父列除外，它恒是树形下拉 ~}}
{{~ # 只勾了单侧新增/编辑的列按状态显隐，否则新增弹窗里会出现一个提交时必被丢弃的字段 ~}}
        <XhFormFieldGroup{{ if col.InCreate && !col.InUpdate }} v-if="!form.basicId"{{ else if col.InUpdate && !col.InCreate }} v-if="form.basicId"{{ end }} name="{{ col.TsProperty }}"{{ if col.ColumnName != TreeParentColumn.ColumnName && col.ControlKind == "textarea" }} class="xh-span-2"{{ end }}>
          <XhFieldRoot>
            <XhFieldLabel>{{ col.Label | html_text }}</XhFieldLabel>
            <XhFieldControl>
{{~ if col.ColumnName == TreeParentColumn.ColumnName ~}}
              <XTreeSelect v-model:value="form.{{ col.TsProperty }}" clearable :options="parentOptions" placeholder="不选则作为根节点" />
{{~ else if col.ControlKind == "switch" ~}}
              <XhSwitch :checked="form.{{ col.TsProperty }} ?? false" @update:checked="(next: boolean) => form.{{ col.TsProperty }} = next" />
{{~ else if col.ControlKind == "select" && col.DictSelectorType == "ConstSelector" ~}}
              <XSelect v-model:value="form.{{ col.TsProperty }}"{{ if col.IsNullable || !col.IsRequired }} clearable{{ end }} :options="{{ col.TsProperty }}ConstOptions" placeholder="请选择{{ col.Label | html_attr }}" />
{{~ else if col.ControlKind == "select" && col.Relation ~}}
              <XCombobox v-model:value="form.{{ col.TsProperty }}"{{ if col.IsNullable || !col.IsRequired }} clearable{{ end }} :options="{{ col.TsProperty }}Options" placeholder="搜索并选择{{ col.Label | html_attr }}" />
{{~ else if col.ControlKind == "select" ~}}
              <XSelect v-model:value="form.{{ col.TsProperty }}"{{ if col.IsNullable || !col.IsRequired }} clearable{{ end }} :options="({{ col.TsProperty }}Options as SelectOption[])" placeholder="请选择{{ col.Label | html_attr }}" />
{{~ else if col.ControlKind == "date" ~}}
              <XDatePicker v-model:value="form.{{ col.TsProperty }}" clearable />
{{~ else if col.ControlKind == "datetime" ~}}
              <XDatePicker v-model:value="form.{{ col.TsProperty }}" clearable show-time />
{{~ else if col.ControlKind == "time" ~}}
              <XInput v-model:value="form.{{ col.TsProperty }}" clearable placeholder="HH:mm:ss" />
{{~ else if col.ControlKind == "treeselect" ~}}
              <XTreeSelect v-model:value="form.{{ col.TsProperty }}" clearable :options="{{ col.TsProperty }}TreeOptions" placeholder="请选择{{ col.Label | html_attr }}" />
{{~ else if col.ControlKind == "image" || col.ControlKind == "file" ~}}
              <!-- 上传到文件中心，字段只存文件主键；使用者需要文件的上传与查看权限 -->
              <XFileRefUpload v-model:value="form.{{ col.TsProperty }}" kind="{{ col.ControlKind }}" />
{{~ else if col.ControlKind == "number" ~}}
              <XNumberInput v-model:value="form.{{ col.TsProperty }}"{{ if col.NumberPrecision != null }} :precision="{{ col.NumberPrecision }}"{{ end }} placeholder="请输入{{ col.Label | html_attr }}" />
{{~ else if col.ControlKind == "binary" ~}}
              <!-- 二进制列：脚手架用文本框承载 Base64，接真实上传请替换成上传组件 -->
              <XInput v-model:value="form.{{ col.TsProperty }}" clearable placeholder="{{ col.Label | html_attr }}（Base64 内容）" />
{{~ else if col.ControlKind == "textarea" ~}}
              <XInput v-model:value="form.{{ col.TsProperty }}" clearable :rows="3" type="textarea"{{ if col.InputMaxLength }} :max-length="{{ col.InputMaxLength }}" show-count{{ end }} placeholder="请输入{{ col.Label | html_attr }}" />
{{~ else ~}}
              <XInput v-model:value="form.{{ col.TsProperty }}" clearable{{ if col.InputMaxLength }} :max-length="{{ col.InputMaxLength }}"{{ end }} placeholder="请输入{{ col.Label | html_attr }}" />
{{~ end ~}}
            </XhFieldControl>
            <XhFieldErrorText />
          </XhFieldRoot>
        </XhFormFieldGroup>
{{~ end ~}}
{{~ end ~}}
      </XhFormRoot>
    </XEditModal>
  </SchemaPage>
{{~ else ~}}
  <SchemaPage{{ if has_actions }} ref="schemaPageRef"{{ end }} :schema="schema"{{ if has_actions }} @action="onAction"{{ end }} />
{{~ end ~}}
</template>
