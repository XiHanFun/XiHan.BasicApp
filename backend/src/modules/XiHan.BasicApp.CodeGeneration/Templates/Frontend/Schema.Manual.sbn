{{~ # 与 .schema.generated.ts 同一判据：一列都不进表单时不产新增，也就没有导入换算可转出 ~}}
{{~ has_form_field = false ~}}
{{~ for col in Columns ~}}
{{~ if col.InForm ~}}
{{~ has_form_field = true ~}}
{{~ end ~}}
{{~ end ~}}
{{~ can_create = CanCreate && has_form_field ~}}
/**
 * {{ TableComment | block_comment }}页面 schema（自定义部分）
 *
 * 本文件仅在首次生成时创建，重新生成时不会被覆盖——自定义代码写在这里是安全的。
 * 由表结构推导的 base* 在 {{ ClassNameKebab }}.schema.generated.ts，会随表结构变化自动更新；
 * 本文件在其之上做 transform 后导出最终结果，index.vue 只从这里导入。
 *
 * 这是前端层的"增量改写"：base 跟随表结构更新，你的微调不受影响。例如
 *   export const fields = baseFields
 *     .filter(field => field.key !== 'internalCode')
 *     .map(field => (field.key === 'status' ? { ...field, render: renderStatusTag } : field))
 */
import { baseActions, baseFields, basePageMeta, createDefaultFormModel } from './{{ ClassNameKebab }}.schema.generated'

export type { {{ ClassName }}FormModel } from './{{ ClassNameKebab }}.schema.generated'

export const pageMeta = { ...basePageMeta }

export const fields = baseFields

export const actions = baseActions

export const createDefaultForm = createDefaultFormModel

export { buildPageQuery{{ if HasDetailTables }}, detailTableColumns{{ end }}{{ if can_create }}, toCreateInputFromImport{{ end }} } from './{{ ClassNameKebab }}.schema.generated'
