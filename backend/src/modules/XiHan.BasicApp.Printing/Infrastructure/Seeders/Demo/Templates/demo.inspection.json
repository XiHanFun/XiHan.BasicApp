{
  "schemaVersion": 1,
  "pages": [
    {
      "id": "inspection",
      "paper": {
        "preset": "A5",
        "width": 148,
        "height": 210
      },
      "orientation": "portrait",
      "margins": {
        "top": 10,
        "right": 10,
        "bottom": 10,
        "left": 10
      },
      "header": {
        "default": {
          "height": 8,
          "elements": [
            {
              "id": "running-title",
              "type": "text",
              "x": 10,
              "y": 10,
              "width": 128,
              "height": 6,
              "content": {
                "kind": "template",
                "template": "设备巡检记录 · {{site}}"
              },
              "style": {
                "fontSize": 8,
                "bold": false,
                "italic": false,
                "underline": false,
                "lineThrough": false,
                "color": "#666666",
                "align": "left",
                "verticalAlign": "middle",
                "lineHeight": 1.2,
                "letterSpacing": 0
              },
              "wrap": false,
              "overflow": "clip",
              "rotation": 0
            }
          ]
        },
        "singleSheet": "first",
        "first": {
          "height": 16,
          "elements": [
            {
              "id": "title",
              "type": "text",
              "x": 10,
              "y": 12,
              "width": 128,
              "height": 10,
              "content": {
                "kind": "static",
                "text": "设备巡检记录"
              },
              "style": {
                "fontSize": 15,
                "bold": true,
                "italic": false,
                "underline": false,
                "lineThrough": false,
                "color": "#000000",
                "align": "center",
                "verticalAlign": "middle",
                "lineHeight": 1.2,
                "letterSpacing": 0
              },
              "wrap": false,
              "overflow": "clip",
              "rotation": 0
            }
          ]
        }
      },
      "footer": {
        "default": {
          "height": 8,
          "elements": [
            {
              "id": "page-number",
              "type": "pageNumber",
              "x": 49,
              "y": 193,
              "width": 50,
              "height": 6,
              "format": "第 {{$page}} 页 / 共 {{$pages}} 页",
              "style": {
                "fontSize": 9,
                "bold": false,
                "italic": false,
                "underline": false,
                "lineThrough": false,
                "color": "#000000",
                "align": "center",
                "verticalAlign": "middle",
                "lineHeight": 1.2,
                "letterSpacing": 0
              }
            }
          ]
        },
        "singleSheet": "last"
      },
      "elements": [
        {
          "id": "notes",
          "type": "longText",
          "x": 10,
          "y": 30,
          "width": 128,
          "height": 20,
          "content": {
            "kind": "field",
            "field": "notes"
          },
          "style": {
            "fontSize": 10.5,
            "bold": false,
            "italic": false,
            "underline": false,
            "lineThrough": false,
            "color": "#000000",
            "align": "left",
            "verticalAlign": "middle",
            "lineHeight": 1.6,
            "letterSpacing": 0
          }
        },
        {
          "id": "checks",
          "type": "table",
          "x": 10,
          "y": 56,
          "width": 128,
          "height": 22,
          "dataField": "checks",
          "columns": [
            {
              "id": "no",
              "title": "序号",
              "width": 12,
              "align": "center",
              "content": {
                "kind": "rowNumber"
              },
              "cellType": "text"
            },
            {
              "id": "device",
              "title": "设备",
              "width": 46,
              "align": "left",
              "content": {
                "kind": "field",
                "field": "device"
              },
              "cellType": "text"
            },
            {
              "id": "item",
              "title": "项目",
              "width": 40,
              "align": "left",
              "content": {
                "kind": "field",
                "field": "item"
              },
              "cellType": "text"
            },
            {
              "id": "result",
              "title": "结果",
              "width": 30,
              "align": "center",
              "content": {
                "kind": "field",
                "field": "result",
                "format": {
                  "kind": "map",
                  "entries": [
                    {
                      "value": "ok",
                      "label": "正常"
                    },
                    {
                      "value": "watch",
                      "label": "待观察"
                    },
                    {
                      "value": "fault",
                      "label": "异常"
                    }
                  ]
                }
              },
              "cellType": "text"
            }
          ],
          "header": {
            "visible": true,
            "repeat": true,
            "height": 8,
            "style": {
              "fontSize": 10.5,
              "bold": true,
              "italic": false,
              "color": "#000000",
              "verticalAlign": "middle",
              "padding": 1,
              "lineHeight": 4.5,
              "align": "center"
            }
          },
          "body": {
            "rowHeight": 7,
            "rowHeightMode": "fixed",
            "style": {
              "fontSize": 10.5,
              "bold": false,
              "italic": false,
              "color": "#000000",
              "verticalAlign": "middle",
              "padding": 1,
              "lineHeight": 4.5
            }
          },
          "footerRows": [
            {
              "id": "page-count",
              "placement": "everyPage",
              "height": 7,
              "style": {
                "fontSize": 10.5,
                "bold": true,
                "italic": false,
                "color": "#000000",
                "verticalAlign": "middle",
                "padding": 1,
                "lineHeight": 4.5
              },
              "cells": [
                {
                  "columnId": "no",
                  "colSpan": 3,
                  "content": {
                    "kind": "static",
                    "text": "本页项数"
                  },
                  "align": "right"
                },
                {
                  "columnId": "result",
                  "colSpan": 1,
                  "content": {
                    "kind": "aggregate",
                    "fn": "count",
                    "scope": "page"
                  }
                }
              ]
            }
          ],
          "fillEmptyRows": false,
          "border": {
            "stroke": {
              "width": 0.2,
              "style": "solid",
              "color": "#000000"
            },
            "outer": true,
            "horizontal": true,
            "vertical": true
          }
        },
        {
          "id": "sign",
          "type": "text",
          "x": 10,
          "y": 82,
          "width": 128,
          "height": 8,
          "content": {
            "kind": "template",
            "template": "检查人：{{inspector}}　　日期：{{date}}"
          },
          "style": {
            "fontSize": 10.5,
            "bold": false,
            "italic": false,
            "underline": false,
            "lineThrough": false,
            "color": "#000000",
            "align": "right",
            "verticalAlign": "middle",
            "lineHeight": 1.2,
            "letterSpacing": 0
          },
          "wrap": false,
          "overflow": "clip",
          "rotation": 0
        }
      ],
      "numbering": {
        "continuous": true,
        "start": 1
      },
      "watermark": {
        "text": "{{site}} 内部使用",
        "fontSize": 16,
        "color": "#999999",
        "opacity": 0.12,
        "rotation": 30,
        "gapX": 25,
        "gapY": 25
      }
    }
  ],
  "name": "设备巡检记录"
}
