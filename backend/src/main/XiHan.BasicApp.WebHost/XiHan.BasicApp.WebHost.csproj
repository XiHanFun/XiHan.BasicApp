<Project Sdk="Microsoft.NET.Sdk.Web">

    <Import Project="..\..\..\props\netcore.props" />
    <Import Project="..\..\..\props\common.props" />
    <Import Project="..\..\..\props\version.props" />

    <PropertyGroup>
        <Title>XiHan.BasicApp.WebHost</Title>
        <AssemblyName>XiHan.BasicApp.WebHost</AssemblyName>
        <PackageId>XiHan.BasicApp.WebHost</PackageId>
        <Description>曦寒基础应用 Web 主机</Description>
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\modules\XiHan.BasicApp.AI\XiHan.BasicApp.AI.csproj" />
      <ProjectReference Include="..\..\modules\XiHan.BasicApp.CodeGeneration\XiHan.BasicApp.CodeGeneration.csproj" />
      <ProjectReference Include="..\..\modules\XiHan.BasicApp.Saas\XiHan.BasicApp.Saas.csproj" />
      <ProjectReference Include="..\..\modules\XiHan.BasicApp.Workflow\XiHan.BasicApp.Workflow.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="IpDatabases\ip2region_v4.xdb">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="IpDatabases\ip2region_v6.xdb">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="ServiceScripts\XiHan.BasicApp.bat">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="ServiceScripts\XiHan.BasicApp.ini">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Localization\**\*.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <!-- 数据库升级脚本：SqlScriptMigrationRunner 从 AppContext.BaseDirectory/UpdateScripts 读取，必须随输出/发布一同拷贝 -->
      <None Update="UpdateScripts\**\*.sql">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\" />
    </ItemGroup>

</Project>
