<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>XiHan.BasicApp.Realtime</RootNamespace>
    <Description>XiHan.BasicApp 6.0 实时能力包（Tier 2）：SignalR Hub 的登记与映射（通知 Hub 与各包登记的 Hub，绕过内核管道，经框架的认证方案 XiHan 认证）、连接登记与在线状态、按 Hub 与会话 / 用户 / 侧推送（调用成功提交之后才发出，另有事务之外的立即推送）；配了 Redis 时接 SignalR 背板、在线状态存共享缓存、断开连接经消息广播，跨实例生效。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../XiHan.BasicApp.Contracts/XiHan.BasicApp.Contracts.csproj" />
    <ProjectReference Include="../XiHan.BasicApp.Runtime/XiHan.BasicApp.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
  </ItemGroup>

  <ItemGroup>
    <XiHanFrameworkReference Include="XiHan.Framework.Kernel" />
    <XiHanFrameworkReference Include="XiHan.Framework.Security.Abstractions" />
    <XiHanFrameworkReference Include="XiHan.Framework.Hosting.AspNetCore" />
    <XiHanFrameworkReference Include="XiHan.Framework.Caching.Abstractions" />
    <XiHanFrameworkReference Include="XiHan.Framework.Caching.Redis" />
    <XiHanFrameworkReference Include="XiHan.Framework.Messaging.Abstractions" />
    <XiHanFrameworkReference Include="XiHan.Framework.Persistence.Abstractions" />
  </ItemGroup>
</Project>
