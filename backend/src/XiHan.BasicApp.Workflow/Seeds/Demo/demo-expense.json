{
  "id": "demo-expense",
  "name": "demo-expense",
  "displayName": "费用报销",
  "category": "演示",
  "description": "演示：发起人的直属上级审批（任一人通过即可）；金额超过 10000 还要总经理审批。",
  "variables": [
    { "name": "amount", "required": true, "description": "报销金额；超过 10000 还要总经理审批。" },
    { "name": "reason", "required": false, "defaultValue": "出差", "description": "报销事由。" }
  ],
  "nodes": [
    { "id": "start", "activityType": "Start", "displayName": "开始" },
    {
      "id": "leader-approve",
      "activityType": "UserTask",
      "displayName": "直属上级审批",
      "properties": {
        "AssigneeRules": [{ "type": "StarterLeader", "values": ["1"] }],
        "CompletionPolicy": "Any",
        "ExcludeStarter": true,
        "EmptyAssigneeStrategy": "AutoApprove",
        "Title": "报销 {{ amount }}：{{ reason }}"
      }
    },
    { "id": "amount-check", "activityType": "Decision", "displayName": "金额判断" },
    {
      "id": "gm-approve",
      "activityType": "UserTask",
      "displayName": "总经理审批",
      "properties": {
        "AssigneeRules": [{ "type": "Position", "values": ["gm"] }],
        "CompletionPolicy": "Any",
        "Title": "大额报销 {{ amount }}：{{ reason }}"
      }
    },
    { "id": "end-approved", "activityType": "End", "displayName": "已通过", "properties": { "Outcome": "approved" } },
    { "id": "end-rejected", "activityType": "End", "displayName": "已驳回", "properties": { "Outcome": "rejected" } }
  ],
  "transitions": [
    { "id": "t-start", "sourceNodeId": "start", "targetNodeId": "leader-approve" },
    { "id": "t-leader-approved", "sourceNodeId": "leader-approve", "targetNodeId": "amount-check", "condition": "outcome == 'approved'" },
    { "id": "t-leader-rejected", "sourceNodeId": "leader-approve", "targetNodeId": "end-rejected", "condition": "outcome == 'rejected'" },
    { "id": "t-large", "sourceNodeId": "amount-check", "targetNodeId": "gm-approve", "condition": "amount > 10000", "priority": 1, "displayName": "超过 10000" },
    { "id": "t-small", "sourceNodeId": "amount-check", "targetNodeId": "end-approved", "isDefault": true, "displayName": "不超过 10000" },
    { "id": "t-gm-approved", "sourceNodeId": "gm-approve", "targetNodeId": "end-approved", "condition": "outcome == 'approved'" },
    { "id": "t-gm-rejected", "sourceNodeId": "gm-approve", "targetNodeId": "end-rejected", "condition": "outcome == 'rejected'" }
  ]
}
