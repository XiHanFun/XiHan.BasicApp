<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\props\netcore.props" />
    <Import Project="..\..\props\common.props" />

    <PropertyGroup>
        <Title>XiHan.BasicApp.DataSourceSample</Title>
        <AssemblyName>XiHan.BasicApp.DataSourceSample</AssemblyName>
        <Description>验证框架实体数据源（模块分库）路由的示例</Description>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <XiHanFrameworkSrc>$(MSBuildThisFileDirectory)..\..\..\..\XiHan.Framework\framework\src\</XiHanFrameworkSrc>
    </PropertyGroup>

    <!--
        本示例直接引框架源码，不走 backend/props/framework.props 的解决方案判定：
        它验证的 [DataSource] 路由尚未随 NuGet 包发布，引包必然编译不过。
        因此也刻意不登记进 XiHan.BasicApp.slnx（那份解决方案恒走 NuGet）。
    -->
    <Target Name="EnsureFrameworkSource" BeforeTargets="PrepareForBuild"
            Condition=" !Exists('$(XiHanFrameworkSrc)XiHan.Framework.Data\XiHan.Framework.Data.csproj') ">
        <Error Text="未找到框架源码：$(XiHanFrameworkSrc)。本示例需要与 XiHan.BasicApp 并列检出 XiHan.Framework。" />
    </Target>

    <ItemGroup>
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Data\XiHan.Framework.Data.csproj" />
        <ProjectReference Include="$(XiHanFrameworkSrc)XiHan.Framework.Logging\XiHan.Framework.Logging.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
