<Project Sdk="Microsoft.NET.Sdk">

  <!-- 宿主进程测试项目：覆盖三个健康检查的健康/降级/故障判定与宿主模块装配契约。 -->
  <Import Project="..\..\props\netcore.props" />
  <Import Project="..\..\props\common.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 被测代码位于 ASP.NET Core 中间件与健康检查层，需要显式引入共享框架才能构造 DefaultHttpContext 等测试替身 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\main\XiHan.BasicApp.WebHost\XiHan.BasicApp.WebHost.csproj" />
  </ItemGroup>

</Project>
