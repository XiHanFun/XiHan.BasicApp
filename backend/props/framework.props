<Project>
  <!--
    XiHan.Framework 的引用方式。

    缺省走 ProjectReference：同级检出 ../../XiHan.Framework/framework/src 的源码，
    并锁定在 XiHanFrameworkCommit 指定的提交（Architecture.Tests 核对检出的 HEAD）。升级框架时改这一处并集中处理公开面变化。

        dotnet build -p:UseXiHanFrameworkSource=false                     NuGet 包（版本见 XiHanFrameworkPackageVersion）
        dotnet build -p:XiHanFrameworkSrc=<检出>/framework/src/             框架源码不在同级目录时显式指路

    工程文件里只写 <XiHanFrameworkReference Include="XiHan.Framework.Xxx" />，由 Directory.Build.targets 翻译成对应引用。
  -->
  <PropertyGroup>
    <XiHanFrameworkCommit>53253917e</XiHanFrameworkCommit>
    <XiHanFrameworkPackageVersion>5.0.0-preview.*</XiHanFrameworkPackageVersion>
    <XiHanFrameworkSrc Condition="'$(XiHanFrameworkSrc)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\..\XiHan.Framework\framework\src'))</XiHanFrameworkSrc>
    <UseXiHanFrameworkSource Condition="'$(UseXiHanFrameworkSource)' == '' AND Exists('$(XiHanFrameworkSrc)XiHan.Framework.Kernel\XiHan.Framework.Kernel.csproj')">true</UseXiHanFrameworkSource>
    <UseXiHanFrameworkSource Condition="'$(UseXiHanFrameworkSource)' == ''">false</UseXiHanFrameworkSource>
  </PropertyGroup>
</Project>
